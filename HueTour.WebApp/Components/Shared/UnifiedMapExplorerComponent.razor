@using System.Globalization
@using HueTour.UseCases.Common
@using HueTour.UseCases.FoodPlaces
@using HueTour.UseCases.MapExplorer
@implements IAsyncDisposable
@inject IMapPoiCatalogUseCase MapPoiUseCase
@inject IJSRuntime JS

<aside class="unified-map-panel food-map-panel" data-unified-map-root="@_elementId">
    <div class="food-map-head">
        <div>
            <h3><i class="bi bi-map me-2"></i>Bản đồ khám phá</h3>
            <span class="food-map-note">Ẩm thực · tham quan · OpenStreetMap</span>
        </div>
        <div class="food-map-head-actions">
            @if (_hasSpatialFilter)
            {
                <button type="button" class="food-map-reset" @onclick="ResetSpatialFiltersAsync">Xóa lọc vị trí</button>
            }
            @if (OnCollapse.HasDelegate)
            {
                <button type="button" class="food-map-collapse" @onclick="OnCollapse" aria-label="Thu gọn bản đồ" title="Thu gọn bản đồ">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
            }
        </div>
    </div>

    <div class="unified-map-controls">
        <label class="unified-map-search">
            <span class="visually-hidden">Tìm địa điểm trên bản đồ</span>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input value="@_keyword" @oninput="ChangeKeywordAsync" placeholder="Tìm quán ăn, di tích, món đặc trưng…" aria-label="Tìm địa điểm trên bản đồ" />
        </label>
        <div class="unified-map-filter-row" role="group" aria-label="Loại địa điểm trên bản đồ">
            <label><input type="checkbox" checked="@_includeAttractions" @onchange="args => ChangeTypeAsync(MapPoiType.Attraction, args)" /> <span><i class="bi bi-bank"></i> Di tích &amp; tham quan</span></label>
            <label><input type="checkbox" checked="@_includeFood" @onchange="args => ChangeTypeAsync(MapPoiType.Food, args)" /> <span><i class="bi bi-egg-fried"></i> Ẩm thực</span></label>
            @if (_categories.Any(category => category.Type == MapPoiType.Unknown))
            {
                <label><input type="checkbox" checked="@_includeUnknown" @onchange="args => ChangeTypeAsync(MapPoiType.Unknown, args)" /> <span><i class="bi bi-three-dots"></i> Khác</span></label>
            }
        </div>
        <div class="unified-map-tools">
            <label class="unified-map-category">
                <span>Danh mục</span>
                <select value="@_category" @onchange="ChangeCategoryAsync" aria-label="Lọc danh mục trên bản đồ">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in VisibleCategories)
                    {
                        <option value="@category.Name">@category.Name (@category.Count)</option>
                    }
                </select>
            </label>
            @if (ShowRadiusPicker)
            {
                <label class="unified-map-radius">
                    <span>Bán kính</span>
                    <select value="@_radiusKm.ToString(CultureInfo.InvariantCulture)" @onchange="ChangeRadiusAsync" aria-label="Chọn bán kính tìm kiếm">
                        <option value="1">1 km</option>
                        <option value="3">3 km</option>
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                    </select>
                </label>
            }
            <button type="button" class="btn-royal-gold btn-sm unified-map-locate" @onclick="FindNearMeAsync" disabled="@_locating">
                @if (_locating)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-crosshair me-1"></i>
                }
                Tìm quanh tôi
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="unified-map-status" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Đang tải địa điểm…</div>
    }
    else if (_refreshing)
    {
        <div class="unified-map-status" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Đang cập nhật địa điểm…</div>
    }
    @if (!string.IsNullOrWhiteSpace(_locationMessage))
    {
        <div class="unified-map-message" role="alert"><i class="bi bi-info-circle me-1"></i>@_locationMessage</div>
    }
    @if (_warnings.Count > 0)
    {
        <div class="unified-map-message" role="status"><i class="bi bi-cloud-slash me-1"></i>@string.Join(" ", _warnings)</div>
    }

    <div class="food-map-wrap unified-map-wrap">
        <div id="@_elementId" class="food-map unified-map-canvas" role="application" aria-label="Bản đồ ẩm thực và điểm tham quan"></div>
        <div class="food-map-legend unified-map-legend" aria-label="Chú giải loại địa điểm"></div>
        @if (!_loading && !_refreshing && _pois.Count == 0)
        {
            <div class="food-map-empty unified-map-empty">
                <i class="bi bi-geo-alt"></i>
                <strong>Chưa tìm thấy địa điểm phù hợp</strong>
                <span>Thử đổi từ khóa, danh mục hoặc bán kính tìm kiếm.</span>
            </div>
        }
    </div>
    <p class="food-map-hint unified-map-hint">
        @(_loading || _refreshing ? "Đang cập nhật dữ liệu địa điểm…" : $"Đang hiển thị {_pois.Count.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))} địa điểm · Kéo bản đồ để xem khu vực khác.")
        Bản đồ © OpenStreetMap contributors.
    </p>
</aside>

@code {
    private readonly string _elementId = "hue-unified-map-" + Guid.NewGuid().ToString("N");
    private IReadOnlyList<MapPoiDto> _pois = Array.Empty<MapPoiDto>();
    private IReadOnlyList<MapPoiCategory> _categories = Array.Empty<MapPoiCategory>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();
    private DotNetObjectReference<UnifiedMapExplorerComponent>? _dotNetReference;
    private CancellationTokenSource? _keywordDebounce;
    private CancellationTokenSource? _searchCancellation;
    private (double Lat, double Lng)? _origin;
    private (double? Lat, double? Lng)? _lastParameterOrigin;
    private GeoViewport? _bounds;
    private GeoViewport? _lastViewport;
    private string _keyword = string.Empty;
    private string? _initialKeyword;
    private string _category = string.Empty;
    private bool _includeAttractions = true;
    private bool _includeFood = true;
    private bool _includeUnknown;
    private bool _loading = true;
    private bool _refreshing;
    private bool _mapDirty = true;
    private bool _jsReady;
    private bool _initialLoadCompleted;
    private bool _locating;
    private bool _nearMeActive;
    private bool _disposed;
    private string? _locationMessage;
    private double _radiusKm = 3;
    private double? _lastRadiusParameter;
    private string? _lastQuerySignature;
    private int _loadVersion;

    [Parameter] public double? InitialLatitude { get; set; }
    [Parameter] public double? InitialLongitude { get; set; }
    [Parameter] public double? InitialRadiusKm { get; set; }
    [Parameter] public string? InitialKeyword { get; set; }
    [Parameter] public bool ShowRadiusPicker { get; set; } = true;
    [Parameter] public EventCallback<double> SelectedRadiusKmChanged { get; set; }
    [Parameter] public EventCallback<GeoViewport> OnViewportChanged { get; set; }
    [Parameter] public EventCallback<(double Lat, double Lng)> OnUserLocated { get; set; }
    [Parameter] public EventCallback<string> OnFocusPlace { get; set; }
    [Parameter] public EventCallback OnResetSpatialFilters { get; set; }
    [Parameter] public EventCallback OnCollapse { get; set; }

    private IEnumerable<MapPoiCategory> VisibleCategories => _categories
        .Where(category => category.Type switch
        {
            MapPoiType.Attraction => _includeAttractions,
            MapPoiType.Food => _includeFood,
            _ => _includeUnknown
        });

    private bool _hasSpatialFilter => _nearMeActive || _bounds is not null;

    protected override async Task OnParametersSetAsync()
    {
        var parameterOrigin = (InitialLatitude, InitialLongitude);
        var shouldReload = false;
        if (_lastParameterOrigin != parameterOrigin)
        {
            _lastParameterOrigin = parameterOrigin;
            (double Lat, double Lng)? nextOrigin = InitialLatitude.HasValue && InitialLongitude.HasValue
                ? (InitialLatitude.Value, InitialLongitude.Value)
                : null;
            if (_origin != nextOrigin)
            {
                _origin = nextOrigin;
                _bounds = null;
                shouldReload = true;
            }
        }

        if (!string.Equals(_initialKeyword, InitialKeyword, StringComparison.Ordinal))
        {
            _initialKeyword = InitialKeyword;
            _keyword = InitialKeyword ?? string.Empty;
            shouldReload = true;
        }

        if (_lastRadiusParameter != InitialRadiusKm && InitialRadiusKm is { } radius)
        {
            _lastRadiusParameter = InitialRadiusKm;
            var nextRadius = ValidRadius(radius) ? radius : 3;
            if (_radiusKm != nextRadius)
            {
                _radiusKm = nextRadius;
                shouldReload = true;
            }
        }

        var signature = QuerySignature();
        if (shouldReload || _lastQuerySignature is null)
        {
            await LoadAsync();
        }
        else if (!string.Equals(signature, _lastQuerySignature, StringComparison.Ordinal))
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dotNetReference ??= DotNetObjectReference.Create(this);
        if (!_mapDirty || _disposed)
        {
            return;
        }

        // The first interactive render can happen while the initial catalogue query
        // is still running. Waiting for it prevents an empty map from being created
        // and then immediately starting a second, slower live query.
        if (!_initialLoadCompleted && _pois.Count == 0)
        {
            return;
        }

        var center = _origin ?? (16.4637, 107.5909);
        var points = _pois.Select(poi => new
        {
            id = poi.Id,
            type = poi.Type.ToString().ToLowerInvariant(),
            name = poi.Name,
            category = poi.Category,
            address = poi.Address,
            description = poi.Description,
            imageUrl = poi.ImageUrl,
            detailUrl = poi.DetailUrl,
            latitude = poi.Latitude,
            longitude = poi.Longitude,
            distanceKm = poi.DistanceKm,
            phone = poi.Phone,
            openingHours = poi.OpeningHours,
            signatureDish = poi.SignatureDish,
            priceLabel = poi.PriceLabel,
            ratingLabel = poi.RatingLabel,
            dataSource = poi.DataSource
        }).ToList();

        try
        {
            await JS.InvokeVoidAsync("hueUnifiedMap.render", _elementId, points, center.Lat, center.Lng, _dotNetReference);
            _mapDirty = false;
            if (!_jsReady)
            {
                // External OSM data is intentionally skipped during prerendering so the
                // page never waits for a public API before it can render. Once the
                // interactive circuit is live, enrich the curated catalogue in the
                // background while the map stays usable.
                _jsReady = true;
                await LoadAsync();
            }
        }
        catch (JSException)
        {
            _locationMessage ??= "Bản đồ chưa tải được. Danh sách địa điểm vẫn dùng được; vui lòng thử tải lại trang.";
            _mapDirty = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // JS interop is not available during prerendering; the next interactive render retries.
        }
    }

    public Task FocusPlaceAsync(string placeId) => JS.InvokeVoidAsync("hueUnifiedMap.focus", _elementId, placeId).AsTask();

    public Task HighlightPlaceAsync(string placeId) => JS.InvokeVoidAsync("hueUnifiedMap.highlight", _elementId, placeId).AsTask();

    public Task RefreshSizeAsync() => JS.InvokeVoidAsync("hueUnifiedMap.invalidateSize", _elementId).AsTask();

    public Task ScrollToPlaceCardAsync(string placeId) => JS.InvokeVoidAsync("hueUnifiedMap.scrollToCard", placeId).AsTask();

    private async Task LoadAsync()
    {
        if (_disposed)
        {
            return;
        }

        var version = Interlocked.Increment(ref _loadVersion);
        var cancellation = new CancellationTokenSource();
        var previousCancellation = _searchCancellation;
        _searchCancellation = cancellation;
        try
        {
            previousCancellation?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // The previous request completed while this request was starting.
        }

        _refreshing = _pois.Count > 0;
        _loading = !_refreshing;
        _locationMessage = null;
        var signature = QuerySignature();
        _lastQuerySignature = signature;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await MapPoiUseCase.SearchAsync(new MapPoiQuery
            {
                Keyword = _keyword,
                Category = string.IsNullOrWhiteSpace(_category) ? null : _category,
                NearLatitude = _origin?.Lat,
                NearLongitude = _origin?.Lng,
                RadiusKm = _origin.HasValue && ShowRadiusPicker ? _radiusKm : null,
                Bounds = _bounds,
                IncludeLiveData = _jsReady,
                IncludeAttractions = _includeAttractions,
                IncludeFood = _includeFood,
                IncludeUnknown = _includeUnknown
            }, cancellation.Token);
            if (version != _loadVersion || _disposed)
            {
                return;
            }

            _initialLoadCompleted = true;
            _pois = result.Items;
            _categories = result.Categories;
            _warnings = result.Warnings;
            _mapDirty = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            // A newer map query replaced this one.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (version != _loadVersion || _disposed)
            {
                return;
            }

            _pois = Array.Empty<MapPoiDto>();
            _warnings = ["Không tải được dữ liệu bản đồ lúc này. Danh sách các trang vẫn hoạt động; vui lòng thử lại sau."];
            _mapDirty = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            if (ReferenceEquals(_searchCancellation, cancellation))
            {
                _searchCancellation = null;
            }
            cancellation.Dispose();
            if (version == _loadVersion && !_disposed)
            {
                _loading = false;
                _refreshing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ChangeKeywordAsync(ChangeEventArgs args)
    {
        _keyword = args.Value?.ToString() ?? string.Empty;
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
        _keywordDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(350, _keywordDebounce.Token);
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke has replaced this pending search.
        }
    }

    private async Task ChangeTypeAsync(MapPoiType type, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        switch (type)
        {
            case MapPoiType.Attraction: _includeAttractions = enabled; break;
            case MapPoiType.Food: _includeFood = enabled; break;
            default: _includeUnknown = enabled; break;
        }
        if (!VisibleCategories.Any(category => string.Equals(category.Name, _category, StringComparison.OrdinalIgnoreCase)))
        {
            _category = string.Empty;
        }
        await LoadAsync();
    }

    private async Task ChangeCategoryAsync(ChangeEventArgs args)
    {
        _category = args.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    }

    private async Task ChangeRadiusAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var radius)
            && ValidRadius(radius))
        {
            _radiusKm = radius;
            await SelectedRadiusKmChanged.InvokeAsync(radius);
            if (_origin.HasValue)
            {
                await LoadAsync();
            }
        }
    }

    private async Task FindNearMeAsync()
    {
        _locationMessage = null;
        _locating = true;
        try
        {
            var accepted = await JS.InvokeAsync<bool>("hueUnifiedMap.requestLocation", _dotNetReference);
            if (!accepted)
            {
                _locating = false;
            }
        }
        catch (JSException)
        {
            _locating = false;
            _locationMessage = "Không thể lấy vị trí ngay lúc này. Hãy thử lại hoặc tìm theo tên địa điểm.";
        }
    }

    private async Task ResetSpatialFiltersAsync()
    {
        _bounds = null;
        _lastViewport = null;
        _nearMeActive = false;
        _origin = InitialLatitude.HasValue && InitialLongitude.HasValue
            ? (InitialLatitude.Value, InitialLongitude.Value)
            : null;
        _locationMessage = null;
        await OnResetSpatialFilters.InvokeAsync();
        await LoadAsync();
    }

    [JSInvokable("OnUnifiedViewportChanged")]
    public async Task NotifyViewportChanged(double west, double south, double east, double north)
    {
        var viewport = new GeoViewport(west, south, east, north);
        if (_lastViewport is { } previous && !FoodPlaceCatalogUseCase.IsViewportShiftSignificant(previous, viewport))
        {
            return;
        }

        _lastViewport = viewport;
        _bounds = viewport;
        await OnViewportChanged.InvokeAsync(viewport);
        await LoadAsync();
    }

    [JSInvokable("OnUnifiedUserLocated")]
    public async Task NotifyUserLocated(double latitude, double longitude)
    {
        _locating = false;
        _locationMessage = null;
        _origin = (latitude, longitude);
        _nearMeActive = true;
        _bounds = null;
        _lastViewport = null;
        await SelectedRadiusKmChanged.InvokeAsync(_radiusKm);
        await OnUserLocated.InvokeAsync((latitude, longitude));
        await LoadAsync();
    }

    [JSInvokable]
    public async Task OnUnifiedUserLocationError(string errorCode)
    {
        _locating = false;
        _locationMessage = errorCode switch
        {
            "permission-denied" => "Bạn đã từ chối chia sẻ vị trí. Hãy bật quyền định vị cho trang rồi thử lại.",
            "not-supported" => "Trình duyệt này chưa hỗ trợ xác định vị trí. Bạn vẫn có thể tìm bằng bộ lọc.",
            "insecure-context" => "Định vị chỉ dùng được qua HTTPS hoặc localhost.",
            "position-unavailable" => "Chưa xác định được vị trí. Hãy kiểm tra GPS hoặc thử lại ở nơi thoáng hơn.",
            "timeout" => "Tìm vị trí mất quá lâu. Hãy thử lại khi kết nối ổn định hơn.",
            _ => "Không thể lấy vị trí lúc này. Bạn vẫn có thể tìm bằng bộ lọc."
        };
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("OnUnifiedMarkerSelected")]
    public Task NotifyMarkerSelected(string placeId) => OnFocusPlace.InvokeAsync(placeId);

    private string QuerySignature() => string.Join("|",
        _keyword,
        _category,
        _origin?.Lat.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _origin?.Lng.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _bounds?.West.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _bounds?.South.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _bounds?.East.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _bounds?.North.ToString("F5", CultureInfo.InvariantCulture) ?? string.Empty,
        _radiusKm.ToString(CultureInfo.InvariantCulture),
        _includeAttractions,
        _includeFood,
        _includeUnknown);

    private static bool ValidRadius(double radius) => radius is 1 or 3 or 5 or 10;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _searchCancellation?.Cancel();
        _keywordDebounce?.Cancel();
        _keywordDebounce?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("hueUnifiedMap.dispose", _elementId);
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit may already be closed during navigation.
        }
        catch (InvalidOperationException)
        {
            // The component may be disposed before JS interop is available.
        }

        _dotNetReference?.Dispose();
    }
}
