@using HueTour.CoreBusiness

<div class="tour-card">
    <div class="tour-card-img-wrap">
        <img src="@CoverPhoto.Url" alt="@CoverPhoto.Caption" loading="lazy" />
        <span class="tour-category-badge">@Tour.Category</span>
        <span class="tour-cover-caption">@CoverPhoto.Caption</span>
        @if (!string.IsNullOrWhiteSpace(CoverPhoto.CreditUrl))
        {
            <a class="tour-image-source" href="@CoverPhoto.CreditUrl" target="_blank" rel="noopener noreferrer" aria-label="Nguồn ảnh: @CoverPhoto.Credit" @onclick:stopPropagation="true">
                <i class="bi bi-image me-1"></i>Nguồn ảnh
            </a>
        }
        <span class="tour-duration-badge">
            <i class="bi bi-clock me-1"></i>@Tour.Duration
        </span>
    </div>
    <div class="tour-card-body d-flex flex-column flex-grow-1">
        <div class="text-muted small mb-2 d-flex align-items-center">
            <i class="bi bi-geo-alt text-danger me-1"></i>
            <span class="text-truncate">@Tour.StartingLocation</span>
        </div>
        <h5 class="fw-bold tour-title mb-2">
            <a href="/tour/@Tour.Id" class="text-decoration-none text-dark">@Tour.Title</a>
        </h5>
        <p class="tour-card-description text-muted small mb-3 flex-grow-1">
            @Tour.ShortDescription
        </p>
        @if (!string.IsNullOrWhiteSpace(Tour.ProviderName))
        {
            <div class="small text-muted mb-2">Giá tham khảo từ @Tour.ProviderName</div>
        }

        <div class="border-top pt-3 d-flex align-items-center justify-content-between mt-auto">
            <div>
                <span class="text-muted small d-block">Giá khởi điểm</span>
                <span class="fw-bold text-purple fs-5">
                    @Tour.BasePrice.ToString("N0") <small class="text-muted fs-6">đ/khách</small>
                </span>
            </div>
            <a href="/tour/@Tour.Id" class="btn btn-royal rounded-pill px-3 py-2 btn-sm">
                Chi tiết <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Tour Tour { get; set; } = null!;

    [Parameter]
    public EventCallback<int> OnTourSelected { get; set; }

    private TourGalleryPhoto CoverPhoto => TourImageCatalog.GetCoverPhoto(Tour);
}
