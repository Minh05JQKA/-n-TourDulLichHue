@using HueTour.CoreBusiness.BusinessRules
@page "/"
@inject IViewToursUseCase ViewToursUseCase
@inject ISearchToursUseCase SearchToursUseCase
@inject NavigationManager NavManager

<PageTitle>Tour Du Lịch Huế - Khám Phá Di Sản Vàng Son</PageTitle>

<!-- Hero Section Hoàng Cung Huế -->
<section class="hue-hero">
    <div class="container hue-hero-content">
        <span class="hue-hero-subtitle d-inline-flex align-items-center mb-4">
            <i class="bi bi-compass-fill me-2"></i>Di sản thế giới · Kinh đô triều Nguyễn
        </span>
        <div class="hero-title-frame">
            <h1 class="hue-hero-title fw-bold mb-0 font-serif text-white">
                Huế, chạm vào
                <span class="d-block text-gold">miền di sản</span>
            </h1>
        </div>
        <p class="hue-hero-description mb-4">
            Từ Hoàng thành trầm mặc đến phá Tam Giang mênh mang — chọn một hành trình để cảm nhận Huế theo cách của riêng bạn.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <a href="tours" class="btn btn-gold btn-lg rounded-pill px-4 py-3 shadow">
                <i class="bi bi-compass me-2"></i>Khám Phá Các Hành Trình
            </a>
            <a href="ai-consultant" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3">
                <i class="bi bi-stars me-2"></i>Gợi ý hành trình
            </a>
        </div>
        <div class="hero-highlights d-flex flex-wrap gap-3 gap-md-4 mt-5">
            <span><i class="bi bi-compass me-2"></i>@allTours.Count() hành trình gợi ý</span>
            <span><i class="bi bi-geo-alt me-2"></i>Di sản · thiên nhiên · ẩm thực</span>
            <span><i class="bi bi-camera me-2"></i>Ảnh có ghi nguồn tham khảo</span>
        </div>
    </div>
</section>

<!-- Floating Search Bar Component (K3.1) -->
<div class="container home-search-wrap mb-5">
    <SearchBarComponent SearchTerm="@searchTerm"
                        SelectedCategory="@selectedCategory"
                        OnSearchExecuted="HandleSearch" />
</div>

<!-- Main Tours Section -->
<div class="container py-4">
    <!-- Tiêu đề danh sách -->
    <div class="section-heading d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
            <span class="section-eyebrow text-gold fw-bold small text-uppercase letter-spacing-1">
                <i class="bi bi-flower1 me-1"></i>ĐI THEO NHỊP RIÊNG CỦA BẠN
            </span>
            <h2 class="font-serif fw-bold text-purple mb-0">Những hành trình nổi bật ở Huế</h2>
        </div>
        <div class="mt-2 mt-md-0">
            <span class="tour-count-pill"><i class="bi bi-compass me-2"></i><strong>@allTours.Count()</strong> hành trình gợi ý</span>
        </div>
    </div>
    <p class="text-muted small mb-4">Tuyến, mức giá và lịch khởi hành trong website là dữ liệu capstone để tham khảo luồng đặt chỗ.</p>

    <!-- Tours Grid (K3.1: TourCardComponent) -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-purple" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách tour...</p>
        </div>
    }
    else if (!displayedTours.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4" style="border-radius: 16px;">
            <div class="display-4 text-muted mb-3">🔍</div>
            <h4 class="fw-bold text-purple">Không tìm thấy tour phù hợp</h4>
            <p class="text-muted">Không có tour nào khớp với từ khóa "@searchTerm". Quý khách vui lòng thử tìm kiếm khác.</p>
            <button class="btn btn-royal rounded-pill px-4 mx-auto" @onclick="ResetSearch">Xem tất cả tour</button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tour in displayedTours)
            {
                <div class="col-lg-4 col-md-6 col-12">
                    <TourCardComponent Tour="@tour" OnTourSelected="NavigateToTour" />
                </div>
            }
        </div>

        @if (string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="text-center mt-5">
                <a href="tours" class="btn btn-royal rounded-pill px-4 py-3">Xem toàn bộ @allTours.Count() hành trình <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        }
    }
</div>

<!-- Khối Giới Thiệu 2 Luật Nghiệp Vụ Minh Bạch (K1.3, K3.3) -->
<section class="rules-section py-5 border-top border-bottom my-5">
    <div class="container">
        <div class="text-center mb-5 rule-intro">
            <span class="badge bg-purple px-3 py-2 text-gold mb-2">QUY CHUẨN ĐỒ ÁN CAPSTONE ECO2415</span>
            <h2 class="font-serif fw-bold text-purple">Cam Kết 2 Luật Nghiệp Vụ Minh Bạch</h2>
            <p class="text-muted">Hệ thống áp dụng chuẩn kiến trúc Clean Architecture 4 tầng, bảo đảm tính toàn vẹn dữ liệu và trải nghiệm công bằng cho hành khách.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-12">
                <div class="card h-100 p-4 border-0 shadow-sm" style="border-radius: 16px; background: #fffcf4; border-left: 6px solid var(--hue-gold) !important;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="fs-1 text-gold">🔒</div>
                        <div>
                            <span class="badge bg-gold text-dark mb-1">LUẬT NGHIỆP VỤ 1 (K1.3)</span>
                            <h5 class="fw-bold text-dark mb-0">Kiểm Soát Sức Chứa &amp; Khóa Đặt @BookingBusinessRules.CutoffHoursBeforeDeparture Giờ</h5>
                        </div>
                    </div>
                    <ul class="text-muted small mb-0" style="line-height: 1.8;">
                        <li><strong>Không nhận quá chỗ:</strong> Tổng số hành khách đặt mới &le; số chỗ trống còn lại của chuyến (MaxCapacity - BookedSeats).</li>
                        <li><strong>Khóa đặt trước @BookingBusinessRules.CutoffHoursBeforeDeparture giờ:</strong> Hệ thống tự động chặn mọi yêu cầu đặt vé mới khi thời gian khởi hành còn dưới @BookingBusinessRules.CutoffHoursBeforeDeparture tiếng, bảo đảm điều hành chuẩn bị xe và hướng dẫn viên chu đáo.</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-6 col-12">
                <div class="card h-100 p-4 border-0 shadow-sm" style="border-radius: 16px; background: #fcf6fc; border-left: 6px solid var(--hue-purple) !important;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="fs-1 text-purple">🏷️</div>
                        <div>
                            <span class="badge bg-purple text-gold mb-1">LUẬT NGHIỆP VỤ 2 (K1.3)</span>
                            <h5 class="fw-bold text-dark mb-0">Biểu Giá Theo Độ Tuổi &amp; Tổng Booking</h5>
                        </div>
                    </div>
                    <ul class="text-muted small mb-0" style="line-height: 1.8;">
                        <li><strong>Em bé dưới 5 tuổi:</strong> Miễn phí 100% giá vé (0 VNĐ).</li>
                        <li><strong>Trẻ em từ 5 đến 11 tuổi:</strong> Tính 50% giá vé người lớn (cấu hình trong PriceRule).</li>
                        <li><strong>Người lớn (&ge; 12 tuổi):</strong> Tính 100% giá vé niêm yết.</li>
                        <li><strong>Tổng booking = &Sigma; vé:</strong> Tổng tiền toàn đơn bằng chính xác tổng giá vé từng hành khách.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private IEnumerable<Tour> allTours = Enumerable.Empty<Tour>();
    private IEnumerable<Tour> displayedTours = Enumerable.Empty<Tour>();
    private string searchTerm = string.Empty;
    private string selectedCategory = "Tất cả";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            allTours = await ViewToursUseCase.ExecuteAsync(activeOnly: true);
            displayedTours = allTours.Take(6).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch((string search, string category) filter)
    {
        searchTerm = filter.search;
        selectedCategory = filter.category;
        isLoading = true;

        displayedTours = await SearchToursUseCase.ExecuteAsync(searchTerm, selectedCategory);
        isLoading = false;
    }

    private void ResetSearch()
    {
        searchTerm = string.Empty;
        selectedCategory = "Tất cả";
        displayedTours = allTours.Take(6).ToList();
    }

    private void NavigateToTour(int tourId)
    {
        NavManager.NavigateTo($"/tour/{tourId}");
    }
}
