@page "/booking/{departureId:int}"
@using System.ComponentModel.DataAnnotations
@using HueTour.CoreBusiness
@using HueTour.CoreBusiness.BusinessRules
@inject IGetDepartureDetailsUseCase GetDepartureDetailsUseCase
@inject ICalculateBookingPricingUseCase CalculateBookingPricingUseCase
@inject IPlaceTourBookingUseCase PlaceTourBookingUseCase
@inject IBookingCartStateService CartStateService
@inject IOptions<VietQrPaymentOptions> VietQrOptions
@inject NavigationManager NavManager
@inject ILogger<Booking> Logger

<PageTitle>Đặt Tour - Điền Thông Tin Đoàn Khách</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-purple" role="status"></div>
        <p class="text-muted mt-2">Đang tải thông tin chuyến khởi hành...</p>
    </div>
}
else if (departure == null || departure.Tour == null)
{
    <div class="container py-5 text-center">
        <div class="alert alert-danger p-4 mx-auto" style="max-width: 600px; border-radius: 16px;">
            <h4 class="fw-bold">Chuyến Khởi Hành Không Tồn Tại</h4>
            <p class="mb-3">Không tìm thấy thông tin chuyến du lịch bạn vừa chọn.</p>
            <a href="/tours" class="btn btn-royal rounded-pill px-4">Xem danh sách các tour</a>
        </div>
    </div>
}
else
{
    <div class="container py-4 booking-page-shell">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-purple">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/tours" class="text-decoration-none text-purple">Tour Du Lịch</a></li>
                <li class="breadcrumb-item"><a href="/tour/@departure.TourId" class="text-decoration-none text-purple">@departure.Tour.Code</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đặt Chỗ &amp; Điền Thông Tin</li>
            </ol>
        </nav>

        <!-- Banner tiêu đề -->
        <div class="bg-royal-gradient p-4 rounded-4 shadow-sm mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge bg-gold text-dark mb-2">ĐẶT TOUR TRỰC TUYẾN</span>
                    <h3 class="font-serif fw-bold text-white mb-1">@departure.Tour.Title</h3>
                    <div class="text-light opacity-90 small">
                        <i class="bi bi-calendar3 me-1 text-gold"></i>Khởi hành lúc: <strong>@departure.DepartureDate.ToString("HH:mm - dd/MM/yyyy")</strong>
                        <span class="mx-2">•</span>
                        <i class="bi bi-geo-alt me-1 text-gold"></i>Tập trung tại: <strong>@departure.MeetingPoint</strong>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge @(departure.AvailableSeats > 5 ? "bg-success" : "bg-warning text-dark") fs-6 px-3 py-2 rounded-pill">
                        <i class="bi bi-people-fill me-1"></i>Còn @departure.AvailableSeats / @departure.MaxCapacity chỗ
                    </span>
                </div>
            </div>
        </div>

        <!-- THÔNG BÁO KIỂM SOÁT LUẬT NGHIỆP VỤ (K3.3: Thân thiện, không văng lỗi) -->
        @if (!string.IsNullOrEmpty(ruleErrorMessage))
        {
            <div class="rule-alert rule-alert-danger animate__animated animate__fadeIn">
                <i class="bi bi-exclamation-triangle-fill fs-3 text-danger flex-shrink-0"></i>
                <div>
                    <h6 class="fw-bold text-danger mb-1">Cảnh Báo Vi Phạm Quy Định Đặt Tour</h6>
                    <div class="small">@ruleErrorMessage</div>
                    <div class="small text-muted mt-1">
                        <em>(Được kiểm tra bởi BookingBusinessRules ở tầng CoreBusiness / UseCases - Tiêu chuẩn K1.3 &amp; K3.3)</em>
                    </div>
                </div>
            </div>
        }

        @if (isWithinCutoff)
        {
            <div class="rule-alert rule-alert-warning">
                <i class="bi bi-lock-fill fs-3 text-warning flex-shrink-0"></i>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Khóa Đặt Vé Tự Động (Luật Nghiệp Vụ 1 - K1.3)</h6>
                    <div class="small">
                        Chuyến đi sẽ khởi hành lúc <strong>@departure.DepartureDate.ToString("HH:mm - dd/MM/yyyy")</strong> (còn dưới @BookingBusinessRules.CutoffHoursBeforeDeparture giờ).
                        Theo quy định, hệ thống đã tạm đóng tiếp nhận đăng ký cho chuyến này để điều hành xe và hướng dẫn viên.
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Form thông tin liên hệ và danh sách hành khách động -->
            <div class="col-lg-8 col-12">
                <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit" @ref="bookingForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-message mb-3" />

                    <!-- 1. Thông tin người đặt tour -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
                        <h5 class="fw-bold text-purple border-bottom pb-2 mb-3">
                            <i class="bi bi-person-lines-fill text-gold me-2"></i>1. Thông Tin Người Đại Diện Đặt Tour
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold text-muted">Họ và tên người đặt <span class="text-danger">*</span></label>
                                <InputText class="form-control" placeholder="VD: Nguyễn Văn Hoàng" @bind-Value="formModel.CustomerFullName" />
                                <ValidationMessage For="@(() => formModel.CustomerFullName)" class="validation-message" />
                            </div>

                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold text-muted">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                <InputText class="form-control" placeholder="VD: 0905123456" @bind-Value="formModel.CustomerPhone" />
                                <ValidationMessage For="@(() => formModel.CustomerPhone)" class="validation-message" />
                            </div>

                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold text-muted">Email nhận vé điện tử <span class="text-danger">*</span></label>
                                <InputText class="form-control" type="email" placeholder="VD: hoang.nguyen@gmail.com" @bind-Value="formModel.CustomerEmail" />
                                <ValidationMessage For="@(() => formModel.CustomerEmail)" class="validation-message" />
                            </div>

                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold text-muted">Địa chỉ liên hệ <span class="text-danger">*</span></label>
                                <InputText class="form-control" placeholder="VD: 12 Lê Lợi, TP Huế" @bind-Value="formModel.CustomerAddress" />
                                <ValidationMessage For="@(() => formModel.CustomerAddress)" class="validation-message" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Ghi chú hoặc yêu cầu đặc biệt (Ăn chay, dị ứng...)</label>
                                <InputTextArea class="form-control" rows="2" placeholder="VD: Có người ăn chay, đón tại khách sạn Hương Giang..." @bind-Value="formModel.Notes" />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Danh sách hành khách động (K3.1, K3.2: Thêm/Xóa dòng động trong EditForm) -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
                        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div>
                                <h5 class="fw-bold text-purple mb-0">
                                    <i class="bi bi-people text-gold me-2"></i>2. Danh Sách Hành Khách Tham Gia Tour
                                </h5>
                                <small class="text-muted">Áp dụng tính giá vé động theo độ tuổi (Luật nghiệp vụ 2)</small>
                            </div>
                            <button type="button" class="btn btn-outline-royal btn-sm rounded-pill px-3 mt-2 mt-sm-0"
                                    @onclick="AddNewPassenger">
                                <i class="bi bi-person-plus-fill me-1"></i>+ Thêm hành khách
                            </button>
                        </div>

                        <!-- Chỉ hiển thị cảnh báo; chặn thật tại PlaceTourBookingUseCase và trong transaction đặt chỗ. -->
                        @if (formModel.Passengers.Count > departure.AvailableSeats)
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                <strong>Cảnh báo Luật 1:</strong> Bạn đang chọn <strong>@formModel.Passengers.Count khách</strong>,
                                nhưng chuyến chỉ còn <strong>@departure.AvailableSeats chỗ trống</strong>! Vui lòng bớt số lượng hoặc chọn chuyến khác.
                            </div>
                        }

                        <!-- Lặp các dòng hành khách động -->
                        @for (int i = 0; i < formModel.Passengers.Count; i++)
                        {
                            int index = i;
                            <PassengerItemComponent Passenger="@formModel.Passengers[index]"
                                                    Index="@index"
                                                    BasePrice="@departure.Tour.BasePrice"
                                                    CanRemove="@(formModel.Passengers.Count > 1)"
                                                    OnRemovePassenger="HandleRemovePassenger"
                                                    OnPassengerUpdated="RecalculateTotal" />
                        }

                        <!-- Tóm tắt số lượng đối tượng -->
                        <div class="bg-light p-3 rounded-3 mt-2 d-flex flex-wrap justify-content-between align-items-center small text-muted">
                            <div>
                                <span>Đoàn hiện tại: </span>
                                <strong class="text-dark">@formModel.Passengers.Count() khách</strong>
                                (<span>@formModel.Passengers.Count(p => p.PassengerType == "Adult") Người lớn</span>,
                                <span>@formModel.Passengers.Count(p => p.PassengerType == "Child") Trẻ em</span>,
                                <span>@formModel.Passengers.Count(p => p.PassengerType == "Infant") Em bé</span>)
                            </div>
                            <div class="text-purple fw-bold">
                                Tính theo công thức: Tổng booking = &Sigma; vé hành khách
                            </div>
                        </div>
                    </div>

                    <!-- 3. Yêu cầu hỗ trợ lưu trú (tùy chọn) -->
                    <div class="card border-0 shadow-sm p-4 mb-4 stay-support-card" style="border-radius: 16px;">
                        <h5 class="fw-bold text-purple border-bottom pb-2 mb-3">
                            <i class="bi bi-building-check text-gold me-2"></i>3. Yêu Cầu Hỗ Trợ Lưu Trú
                            <span class="badge bg-light text-muted border ms-1 fw-normal">Tùy chọn</span>
                        </h5>

                        <label class="stay-support-toggle @(formModel.NeedsAccommodationSupport ? "is-active" : "")"
                               for="accommodationSupport">
                            <InputCheckbox class="form-check-input mt-1" id="accommodationSupport"
                                           @bind-Value="formModel.NeedsAccommodationSupport" />
                            <span class="stay-support-icon">
                                <i class="bi @(formModel.NeedsAccommodationSupport ? "bi-check2-circle" : "bi-building")"></i>
                            </span>
                            <span class="stay-support-copy">
                                <strong>Tôi muốn Hue Tour hỗ trợ tư vấn và đặt khách sạn</strong>
                                <span class="d-block text-muted mt-1">
                                    Miễn phí tư vấn • Chưa phải đặt phòng • Không cộng vào tổng tiền tour.
                                    Nhân viên sẽ liên hệ xác nhận tình trạng phòng và giá trước khi giữ chỗ.
                                </span>
                            </span>
                            <span class="stay-support-state">@(formModel.NeedsAccommodationSupport ? "Đã bật" : "Đang tắt")</span>
                        </label>

                        @if (formModel.NeedsAccommodationSupport)
                        {
                            <div class="stay-support-panel mt-3">
                                <div class="stay-panel-heading">
                                    <span><i class="bi bi-sliders me-1"></i>Thông tin lưu trú mong muốn</span>
                                    <span class="stay-panel-badge">Không bắt buộc đặt phòng ngay</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-muted">Khu vực / khách sạn mong muốn <span class="text-danger">*</span></label>
                                        <InputText class="form-control" placeholder="VD: Gần sông Hương, khu Đại Nội, khách sạn 3 sao..."
                                                   @bind-Value="formModel.AccommodationArea" />
                                        <ValidationMessage For="@(() => formModel.AccommodationArea)" class="validation-message" />
                                        <div class="stay-quick-picks" aria-label="Gợi ý khu vực lưu trú">
                                            @foreach (var area in AccommodationAreaSuggestions)
                                            {
                                                <button type="button"
                                                        class="stay-chip @(formModel.AccommodationArea == area ? "is-selected" : "")"
                                                        @onclick="() => formModel.AccommodationArea = area">
                                                    <i class="bi bi-geo-alt me-1"></i>@area
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-5 col-12">
                                        <label class="form-label small fw-bold text-muted">Số phòng dự kiến <span class="text-danger">*</span></label>
                                        <div class="stay-room-stepper">
                                            <button type="button" class="stay-room-btn"
                                                    aria-label="Giảm số phòng"
                                                    disabled="@((formModel.AccommodationRoomCount ?? 1) <= 1)"
                                                    @onclick="() => ChangeRoomCount(-1)">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>
                                            <InputNumber class="form-control stay-room-input" min="1" max="10"
                                                         @bind-Value="formModel.AccommodationRoomCount" />
                                            <button type="button" class="stay-room-btn"
                                                    aria-label="Tăng số phòng"
                                                    disabled="@((formModel.AccommodationRoomCount ?? 1) >= 10)"
                                                    @onclick="() => ChangeRoomCount(1)">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => formModel.AccommodationRoomCount)" class="validation-message" />
                                    </div>

                                    <div class="col-md-7 col-12">
                                        <div class="stay-date-summary">
                                            <i class="bi bi-moon-stars me-1"></i>
                                            @GetAccommodationDurationText()
                                        </div>
                                    </div>

                                    <div class="col-md-6 col-12">
                                        <label class="form-label small fw-bold text-muted">Ngày nhận phòng <span class="text-danger">*</span></label>
                                        <InputDate class="form-control" @bind-Value="formModel.AccommodationCheckIn" />
                                        <ValidationMessage For="@(() => formModel.AccommodationCheckIn)" class="validation-message" />
                                    </div>

                                    <div class="col-md-6 col-12">
                                        <label class="form-label small fw-bold text-muted">Ngày trả phòng <span class="text-danger">*</span></label>
                                        <InputDate class="form-control"
                                                   min="@(formModel.AccommodationCheckIn?.AddDays(1).ToString("yyyy-MM-dd"))"
                                                   @bind-Value="formModel.AccommodationCheckOut" />
                                        <ValidationMessage For="@(() => formModel.AccommodationCheckOut)" class="validation-message" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-muted">Ghi chú thêm cho lưu trú</label>
                                        <InputTextArea class="form-control" rows="2"
                                                       placeholder="VD: Phòng gia đình, cần chỗ đậu xe, ăn sáng cho trẻ em..."
                                                       @bind-Value="formModel.AccommodationNotes" />
                                        <ValidationMessage For="@(() => formModel.AccommodationNotes)" class="validation-message" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- 4. Phương thức thanh toán -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
                        <h5 class="fw-bold text-purple border-bottom pb-2 mb-3">
                            <i class="bi bi-credit-card-2-front text-gold me-2"></i>4. Phương Thức Thanh Toán
                        </h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6 col-12">
                                <div class="p-3 border rounded-3 @(formModel.PaymentMethod == "Chuyển khoản VietQR" ? "border-primary bg-primary-subtle" : "bg-light")"
                                     style="cursor: pointer;"
                                     @onclick='() => formModel.PaymentMethod = "Chuyển khoản VietQR"'>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="radio" id="pay1" name="paymentRadio"
                                               checked="@(formModel.PaymentMethod == "Chuyển khoản VietQR")"
                                               @onchange='() => formModel.PaymentMethod = "Chuyển khoản VietQR"' />
                                        <label for="pay1" class="small fw-bold mb-0" style="cursor: pointer;">
                                            <i class="bi bi-qr-code-scan text-purple me-1"></i>Chuyển khoản VietQR @(VietQrOptions.Value.IsDemo ? "(demo)" : "")
                                        </label>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4">
                                        @(VietQrOptions.Value.IsDemo
                                            ? "Thông tin thanh toán minh họa, không tạo giao dịch thật."
                                            : $"Chuyển khoản đến tài khoản {VietQrOptions.Value.BankName} của Hue Tour.")
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="p-3 border rounded-3 @(formModel.PaymentMethod == "Thanh toán trực tiếp" ? "border-primary bg-primary-subtle" : "bg-light")"
                                     style="cursor: pointer;"
                                     @onclick='() => formModel.PaymentMethod = "Thanh toán trực tiếp"'>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="radio" id="pay2" name="paymentRadio"
                                               checked="@(formModel.PaymentMethod == "Thanh toán trực tiếp")"
                                               @onchange='() => formModel.PaymentMethod = "Thanh toán trực tiếp"' />
                                        <label for="pay2" class="small fw-bold mb-0" style="cursor: pointer;">
                                            <i class="bi bi-cash-coin text-gold me-1"></i>Thanh toán tiền mặt khi lên xe
                                        </label>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4">Thanh toán trực tiếp với Hướng dẫn viên tại điểm tập trung</small>
                                </div>
                            </div>
                        </div>

                        @if (formModel.PaymentMethod == "Chuyển khoản VietQR")
                        {
                            <div class="p-3 rounded-4 border bg-white shadow-sm mt-3">
                                <div class="row g-3 align-items-center">
                                    @if (!string.IsNullOrWhiteSpace(VietQrOptions.Value.QrImagePath))
                                    {
                                        <div class="col-sm-5 text-center">
                                        <div class="p-2 border rounded-3 bg-light d-inline-block shadow-sm">
                                            <img src="@VietQrOptions.Value.QrImagePath"
                                                 alt="@(VietQrOptions.Value.IsDemo ? "Mã QR minh họa, không dùng để chuyển tiền" : $"Mã QR chuyển khoản {VietQrOptions.Value.BankName} đến {VietQrOptions.Value.AccountHolder}")"
                                                 class="img-fluid rounded-2" style="max-width: 190px;" />
                                        </div>
                                        @if (VietQrOptions.Value.IsDemo)
                                        {
                                            <div class="small text-danger fw-semibold mt-1">Mã QR minh họa phục vụ demo, không dùng để chuyển tiền.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-success fw-semibold mt-1">
                                                <i class="bi bi-shield-check me-1"></i>Quét mã bằng ứng dụng ngân hàng và kiểm tra đúng người nhận trước khi chuyển.
                                            </div>
                                            <div class="small text-muted mt-1">Mã QR chứa thông tin tài khoản; vui lòng nhập đúng số tiền và nội dung chuyển khoản bên cạnh.</div>
                                        }
                                        </div>
                                    }
                                    <div class="@(string.IsNullOrWhiteSpace(VietQrOptions.Value.QrImagePath) ? "col-12" : "col-sm-7")">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="badge bg-danger">@VietQrOptions.Value.BankCode</span>
                                            <span class="small text-muted">@VietQrOptions.Value.BankName</span>
                                        </div>
                                        <div class="mb-2">
                                            <span class="small text-muted d-block">Chủ tài khoản:</span>
                                            <strong class="fs-6 text-purple">@VietQrOptions.Value.AccountHolder</strong>
                                        </div>
                                        <div class="mb-2">
                                            <span class="small text-muted d-block">Số tài khoản:</span>
                                            <code class="fs-5 fw-bold text-dark p-1 px-2 bg-light rounded border">@VietQrOptions.Value.AccountNumber</code>
                                        </div>
                                        <div class="mb-2">
                                            <span class="small text-muted d-block">Số tiền thanh toán:</span>
                                            <strong class="text-success fs-5">@currentTotalAmount.ToString("N0") VNĐ</strong>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-info-circle me-1 text-primary"></i>Nội dung CK: <strong class="text-dark">@VietQrOptions.Value.FormatTransferContent("MÃ ĐẶT TOUR", formModel.CustomerPhone)</strong>
                                            <span class="d-block mt-1">Mã đặt tour chính xác sẽ hiển thị sau khi hoàn tất đặt chỗ.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Hidden submit button triggered by summary component -->
                    <button type="submit" id="hiddenSubmitBtn" style="display: none;"></button>

                    <!-- Thanh đặt tour cố định trên mobile -->
                    <div class="booking-mobile-bar d-lg-none">
                        <div class="booking-mobile-total">
                            <span>Tổng tiền tour</span>
                            <strong>@currentTotalAmount.ToString("N0") VNĐ</strong>
                        </div>
                        <button type="button" class="btn btn-royal rounded-pill px-3 fw-bold"
                                disabled="@(isSubmitting || currentTotalAmount <= 0)"
                                @onclick="TriggerFormSubmit">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check me-1"></i>
                                <span>Đặt Tour</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- Cột phải: Summary Component (K3.1) -->
            <div class="col-lg-4 col-12">
                <TourBookingSummaryComponent Tour="@departure.Tour"
                                            Departure="@departure"
                                            Passengers="@formModel.Passengers"
                                            TotalAmount="@currentTotalAmount"
                                            NeedsAccommodationSupport="@formModel.NeedsAccommodationSupport"
                                            AccommodationArea="@formModel.AccommodationArea"
                                            AccommodationCheckIn="@formModel.AccommodationCheckIn"
                                            AccommodationCheckOut="@formModel.AccommodationCheckOut"
                                            AccommodationRoomCount="@formModel.AccommodationRoomCount"
                                            IsSubmitting="@isSubmitting"
                                            OnSubmitBooking="TriggerFormSubmit" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int DepartureId { get; set; }

    private Departure? departure;
    private EditForm? bookingForm;
    private IEnumerable<PriceRule> priceRules = Enumerable.Empty<PriceRule>();
    private BookingFormViewModel formModel = new();
    private decimal currentTotalAmount = 0;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? ruleErrorMessage = null;
    private bool isWithinCutoff = false;

    private static readonly string[] AccommodationAreaSuggestions =
    {
        "Gần sông Hương",
        "Khu Đại Nội",
        "Gần chợ Đông Ba",
        "Khu Phú Hội",
        "Gần ga Huế"
    };

    public class BookingFormViewModel : IValidatableObject
    {
        [Required(ErrorMessage = "Vui lòng nhập họ và tên người đặt tour")]
        public string CustomerFullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại")]
        [Phone(ErrorMessage = "Số điện thoại không hợp lệ")]
        public string CustomerPhone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập email")]
        [EmailAddress(ErrorMessage = "Địa chỉ email không hợp lệ")]
        public string CustomerEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập địa chỉ liên hệ")]
        public string CustomerAddress { get; set; } = string.Empty;

        public string? Notes { get; set; }
        public string PaymentMethod { get; set; } = "Chuyển khoản VietQR";

        public bool NeedsAccommodationSupport { get; set; }

        [StringLength(90, ErrorMessage = "Khu vực hoặc khách sạn mong muốn tối đa 90 ký tự")]
        public string? AccommodationArea { get; set; }

        [Range(1, 10, ErrorMessage = "Số phòng dự kiến phải từ 1 đến 10")]
        public int? AccommodationRoomCount { get; set; } = 1;

        public DateTime? AccommodationCheckIn { get; set; }
        public DateTime? AccommodationCheckOut { get; set; }

        [StringLength(220, ErrorMessage = "Ghi chú lưu trú tối đa 220 ký tự")]
        public string? AccommodationNotes { get; set; }

        public List<PassengerTicket> Passengers { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!NeedsAccommodationSupport)
            {
                yield break;
            }

            if (string.IsNullOrWhiteSpace(AccommodationArea))
            {
                yield return new ValidationResult(
                    "Vui lòng nhập khu vực hoặc khách sạn mong muốn để Hue Tour hỗ trợ lưu trú.",
                    new[] { nameof(AccommodationArea) });
            }

            if (!AccommodationCheckIn.HasValue)
            {
                yield return new ValidationResult(
                    "Vui lòng chọn ngày nhận phòng.",
                    new[] { nameof(AccommodationCheckIn) });
            }

            if (!AccommodationCheckOut.HasValue)
            {
                yield return new ValidationResult(
                    "Vui lòng chọn ngày trả phòng.",
                    new[] { nameof(AccommodationCheckOut) });
            }

            if (AccommodationCheckIn.HasValue && AccommodationCheckOut.HasValue
                && AccommodationCheckOut.Value.Date <= AccommodationCheckIn.Value.Date)
            {
                yield return new ValidationResult(
                    "Ngày trả phòng phải sau ngày nhận phòng.",
                    new[] { nameof(AccommodationCheckOut) });
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            departure = await GetDepartureDetailsUseCase.ExecuteAsync(DepartureId);
            priceRules = await CalculateBookingPricingUseCase.GetPriceRulesAsync();

            if (departure != null)
            {
                // Kiểm tra sơ bộ Luật 1 (theo hạn đặt)
                isWithinCutoff = (departure.DepartureDate - DateTime.Now).TotalHours < BookingBusinessRules.CutoffHoursBeforeDeparture;

                // Khởi tạo ít nhất 1 hành khách người lớn
                if (!formModel.Passengers.Any())
                {
                    if (CartStateService.SelectedDeparture?.Id == departure.Id && CartStateService.TempPassengers.Any())
                    {
                        formModel.Passengers = CartStateService.TempPassengers.ToList();
                    }
                    else
                    {
                        CartStateService.SelectTourAndDeparture(departure.Tour!, departure);
                        formModel.Passengers = CartStateService.TempPassengers.ToList();
                    }

                    var savedCustomer = CartStateService.TempCustomer;
                    formModel.CustomerFullName = savedCustomer.FullName;
                    formModel.CustomerPhone = savedCustomer.PhoneNumber;
                    formModel.CustomerEmail = savedCustomer.Email;
                    formModel.CustomerAddress = savedCustomer.Address;

                    // Gợi ý thời gian lưu trú theo lịch chuyến; khách vẫn có thể sửa khi gửi yêu cầu.
                    formModel.AccommodationCheckIn = departure.DepartureDate.Date;
                    formModel.AccommodationCheckOut = departure.ReturnDate.Date > departure.DepartureDate.Date
                        ? departure.ReturnDate.Date
                        : departure.DepartureDate.Date.AddDays(1);
                    formModel.AccommodationRoomCount ??= 1;
                }

                await RecalculateTotal();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddNewPassenger()
    {
        if (departure?.Tour != null)
        {
            formModel.Passengers.Add(new PassengerTicket
            {
                FullName = string.Empty,
                Gender = "Nam",
                PassengerType = "Adult",
                BirthYear = DateTime.Now.Year - 20,
                Price = departure.Tour.BasePrice
            });
            await RecalculateTotal();
        }
    }

    private async Task HandleRemovePassenger(int index)
    {
        if (index >= 0 && index < formModel.Passengers.Count && formModel.Passengers.Count > 1)
        {
            formModel.Passengers.RemoveAt(index);
            await RecalculateTotal();
        }
    }

    private async Task RecalculateTotal()
    {
        if (departure?.Tour == null) return;

        currentTotalAmount = await CalculateBookingPricingUseCase.CalculateTotalAmountAsync(departure.Tour.BasePrice, formModel.Passengers);
        StateHasChanged();
    }

    private async Task TriggerFormSubmit()
    {
        ruleErrorMessage = null;

        // Nút tóm tắt và thanh mobile nằm ngoài vùng submit native, nên phải gọi
        // EditContext.Validate() trước khi chạy nghiệp vụ để không bỏ qua DataAnnotations.
        if (bookingForm?.EditContext is not null && !bookingForm.EditContext.Validate())
        {
            StateHasChanged();
            return;
        }

        await HandleValidSubmit();
    }

    private async Task HandleValidSubmit()
    {
        if (departure == null || departure.Tour == null) return;

        ruleErrorMessage = null;
        isSubmitting = true;

        try
        {
            var customer = new Customer
            {
                FullName = formModel.CustomerFullName,
                PhoneNumber = formModel.CustomerPhone,
                Email = formModel.CustomerEmail,
                Address = formModel.CustomerAddress
            };

            // THỰC THI USECASE ĐẶT TOUR:
            // Sẽ gọi các luật nghiệp vụ K1.3 (BookingBusinessRules.ValidateDepartureCapacityAndCutoff & ValidateBookingFares)
            // và lưu CSDL trong 1 Transaction (K2.2)
            var result = await PlaceTourBookingUseCase.ExecuteAsync(
                departureId: departure.Id,
                customer: customer,
                passengers: formModel.Passengers,
                notes: formModel.Notes,
                paymentMethod: formModel.PaymentMethod,
                specialRequests: BuildSpecialRequests()
            );

            if (result.IsSuccess && !string.IsNullOrEmpty(result.BookingCode))
            {
                CartStateService.SetCustomer(customer);
                SyncCartPassengers();
                CartStateService.RecalculateTotal(priceRules);
                // Đặt thành công -> chuyển hướng sang trang xác nhận vé
                NavManager.NavigateTo($"/booking-confirmation/{result.BookingCode}");
            }
            else
            {
                // Báo lỗi thân thiện khi vi phạm Luật 1 hoặc Luật 2 (K3.3)
                ruleErrorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while placing a booking for departure {DepartureId}", departure.Id);
            ruleErrorMessage = "Hệ thống chưa thể xác nhận đơn đặt tour lúc này. Vui lòng thử lại sau hoặc liên hệ quản trị viên.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ChangeRoomCount(int delta)
    {
        var current = formModel.AccommodationRoomCount ?? 1;
        formModel.AccommodationRoomCount = Math.Clamp(current + delta, 1, 10);
    }

    private string GetAccommodationDurationText()
    {
        if (!formModel.AccommodationCheckIn.HasValue || !formModel.AccommodationCheckOut.HasValue)
        {
            return "Chọn ngày nhận và trả phòng để xem số đêm lưu trú.";
        }

        var nights = (formModel.AccommodationCheckOut.Value.Date - formModel.AccommodationCheckIn.Value.Date).Days;
        return nights > 0
            ? $"{nights} đêm lưu trú • {formModel.AccommodationRoomCount ?? 1} phòng dự kiến"
            : "Ngày trả phòng cần sau ngày nhận phòng.";
    }

    private string? BuildSpecialRequests()
    {
        if (!formModel.NeedsAccommodationSupport)
        {
            return null;
        }

        var lines = new List<string>
        {
            "[Yêu cầu hỗ trợ lưu trú]",
            $"Khu vực/khách sạn mong muốn: {formModel.AccommodationArea?.Trim()}",
            $"Ngày nhận phòng: {formModel.AccommodationCheckIn:dd/MM/yyyy}",
            $"Ngày trả phòng: {formModel.AccommodationCheckOut:dd/MM/yyyy}",
            $"Số phòng dự kiến: {formModel.AccommodationRoomCount ?? 1}"
        };

        if (!string.IsNullOrWhiteSpace(formModel.AccommodationNotes))
        {
            lines.Add($"Ghi chú lưu trú: {formModel.AccommodationNotes.Trim()}");
        }

        return string.Join(Environment.NewLine, lines);
    }

    private void SyncCartPassengers()
    {
        for (var i = 0; i < formModel.Passengers.Count; i++)
        {
            if (i < CartStateService.TempPassengers.Count)
                CartStateService.UpdatePassenger(i, formModel.Passengers[i]);
            else
                CartStateService.AddPassenger(formModel.Passengers[i]);
        }

        while (CartStateService.TempPassengers.Count > formModel.Passengers.Count)
            CartStateService.RemovePassengerAt(CartStateService.TempPassengers.Count - 1);
    }
}
