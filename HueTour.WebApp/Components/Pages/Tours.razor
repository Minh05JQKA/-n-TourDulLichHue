@page "/tours"
@inject IViewToursUseCase ViewToursUseCase
@inject ISearchToursUseCase SearchToursUseCase

<PageTitle>Danh Sách Tour Du Lịch Huế - Trọn Gói Giá Tốt</PageTitle>

<header class="tour-page-hero mb-4">
    <div class="container">
        <nav class="tour-breadcrumb" aria-label="Điều hướng">
            <a href="/">Trang chủ</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">Tour du lịch</span>
        </nav>
        <div class="tour-page-hero-copy">
            <span class="tour-page-kicker"><i class="bi bi-compass me-2"></i>HÀNH TRÌNH KHÁM PHÁ HUẾ</span>
            <h1 class="font-serif fw-bold">Chọn nhịp đi Huế của bạn</h1>
            <p>Men theo dấu xưa, xuôi dòng Hương Giang hay khám phá hương vị và làng nghề — bắt đầu từ điều bạn yêu thích.</p>
        </div>
    </div>
</header>

<div class="container py-3">
    <!-- Search & Filter Controls -->
    <section class="tour-filter-card mb-4" aria-label="Tìm và lọc tour">
        <div class="row g-3 align-items-center">
            <div class="col-lg-3 col-md-6 col-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0"
                           placeholder="Tìm theo tên tour, lăng tẩm, điểm đến..."
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @onkeyup="FilterTours" />
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <select class="form-select" @bind="selectedCategory" @bind:after="FilterTours">
                    <option value="Tất cả">Tất cả danh mục (@allTours.Count())</option>
                    <option value="Di tích Cố Đô">Di tích Cố Đô & Hoàng Thành</option>
                    <option value="Sinh thái & Đầm phá">Thiên nhiên, biển &amp; đầm phá</option>
                    <option value="Thiên nhiên & Nghỉ dưỡng">Thiên nhiên &amp; Nghỉ dưỡng</option>
                    <option value="Sông Hương & Làng nghề">Sông Hương & Làng nghề / Nông thôn</option>
                    <option value="Văn hóa & Ẩm thực">Văn hóa & Ẩm thực đêm Cố Đô</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-6 col-12">
                <select class="form-select" @bind="priceRange" @bind:after="FilterTours">
                    <option value="all">Mọi mức giá</option>
                    <option value="under400">Dưới 400.000đ</option>
                    <option value="400to700">400.000–700.000đ</option>
                    <option value="over700">Trên 700.000đ</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6 col-12">
                <select class="form-select" @bind="sortBy" @bind:after="ApplySort">
                    <option value="default">Sắp xếp: Mặc định</option>
                    <option value="price_asc">Giá: Thấp đến Cao</option>
                    <option value="price_desc">Giá: Cao đến Thấp</option>
                </select>
            </div>
        </div>
    </section>

    <div class="tour-listing-toolbar">
        <div>
            <span class="section-eyebrow text-gold fw-bold small text-uppercase">GỢI Ý HÀNH TRÌNH</span>
            <h2 class="font-serif fw-bold text-purple mb-0">Những chuyến đi đáng nhớ</h2>
        </div>
        @if (!isLoading)
        {
            <span class="tour-results-count"><i class="bi bi-map me-2"></i><strong>@filteredTours.Count</strong> tour phù hợp</span>
        }
    </div>

    <!-- Tours Grid -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-purple" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách tour...</p>
        </div>
    }
    else if (!filteredTours.Any())
    {
        <div class="text-center py-5 card border-0 p-5 shadow-sm" style="border-radius: 16px;">
            <div class="fs-1 text-muted mb-2">🔍</div>
            <h4 class="fw-bold text-purple">Không tìm thấy tour phù hợp</h4>
            <p class="text-muted">Vui lòng thử tìm với từ khóa khác hoặc danh mục khác.</p>
            <button class="btn btn-outline-secondary rounded-pill px-4 mx-auto" @onclick="ResetFilter">Đặt lại bộ lọc</button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tour in filteredTours)
            {
                <div class="col-lg-4 col-md-6 col-12">
                    <TourCardComponent Tour="@tour" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Tour> allTours = new();
    private List<Tour> filteredTours = new();
    private string searchTerm = string.Empty;
    private string selectedCategory = "Tất cả";
    private string priceRange = "all";
    private string sortBy = "default";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var tours = await ViewToursUseCase.ExecuteAsync(activeOnly: true);
            allTours = tours.ToList();
            filteredTours = new List<Tour>(allTours);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterTours()
    {
        var query = allTours.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            string term = searchTerm.Trim().ToLowerInvariant();
            query = query.Where(t => t.Title.ToLowerInvariant().Contains(term) ||
                                     t.ShortDescription.ToLowerInvariant().Contains(term) ||
                                     t.Highlights.ToLowerInvariant().Contains(term));
        }

        if (!string.IsNullOrWhiteSpace(selectedCategory) && selectedCategory != "Tất cả")
        {
            query = query.Where(t => string.Equals(t.Category, selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        query = priceRange switch
        {
            "under400" => query.Where(t => t.BasePrice < 400000),
            "400to700" => query.Where(t => t.BasePrice >= 400000 && t.BasePrice <= 700000),
            "over700" => query.Where(t => t.BasePrice > 700000),
            _ => query
        };

        filteredTours = query.ToList();
        ApplySort();
    }

    private void ApplySort()
    {
        filteredTours = sortBy switch
        {
            "price_asc" => filteredTours.OrderBy(t => t.BasePrice).ToList(),
            "price_desc" => filteredTours.OrderByDescending(t => t.BasePrice).ToList(),
            _ => filteredTours.OrderByDescending(t => t.Id).ToList()
        };
    }

    private void ResetFilter()
    {
        searchTerm = string.Empty;
        selectedCategory = "Tất cả";
        sortBy = "default";
        priceRange = "all";
        filteredTours = new List<Tour>(allTours);
    }
}
