@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Đăng Nhập Hệ Thống - Hue Tour Booking</PageTitle>

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto p-4 p-md-5" style="max-width: 480px; border-radius: 20px;">
        <div class="text-center mb-4">
            <span class="fs-1 text-gold">🏛️</span>
            <h3 class="font-serif fw-bold text-purple mb-1">Đăng Nhập Hệ Thống</h3>
            <p class="text-muted small">Cổng thông tin đặt tour &amp; quản trị điều hành Cố Đô</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small mb-3">
                <i class="bi bi-exclamation-circle-fill me-1"></i>@ErrorMessage
            </div>
        }

        <!-- Form gửi POST tới /auth/login để ghi nhận Cookie Authentication (K4.1) -->
        <form action="/auth/login" method="post">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Tên đăng nhập:</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="admin hoặc khachhang" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Mật khẩu:</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-key"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Mật khẩu" required />
                </div>
            </div>

            <button type="submit" class="btn btn-royal btn-lg rounded-pill w-100 fw-bold mb-3">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
            </button>
        </form>

        <!-- Tài khoản mẫu để chấm điểm (K4.1) -->
        <div class="p-3 bg-light rounded-3 border small">
            <strong class="text-purple d-block mb-1"><i class="bi bi-shield-check me-1"></i>Tài khoản dùng thử cho hội đồng chấm:</strong>
            <div class="d-flex justify-content-between mb-1">
                <span>Quản trị viên (Admin):</span>
                <code>admin</code> / <code>Admin@123</code>
            </div>
            <div class="d-flex justify-content-between">
                <span>Khách hàng (Customer):</span>
                <code>khachhang</code> / <code>User@123</code>
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="/" class="small text-muted text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>Quay lại Trang Chủ
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; } = "/";
}
