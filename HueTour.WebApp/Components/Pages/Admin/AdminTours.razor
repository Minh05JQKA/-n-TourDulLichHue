@page "/admin/tours"
@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@inject IViewToursUseCase ViewToursUseCase
@inject IManageToursUseCase ManageToursUseCase

<PageTitle>Quản Lý Tour Du Lịch - Admin</PageTitle>

<div class="container-fluid py-4 px-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-purple text-gold mb-1">DANH MỤC TOUR</span>
            <h2 class="font-serif fw-bold text-purple mb-0">Quản Lý Tuyến Điểm &amp; Tour Huế</h2>
        </div>
        <button class="btn btn-royal rounded-pill px-4 mt-2 mt-md-0" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg me-1"></i>Thêm Tour Mới
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-purple" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách tour...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Ảnh</th>
                            <th>Mã</th>
                            <th>Tên Tour</th>
                            <th>Danh Mục</th>
                            <th>Thời Lượng</th>
                            <th>Giá Gốc</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tours)
                        {
                            <tr>
                                <td style="width: 70px;">
                                    <img src="@t.ImageUrl" alt="@t.Title" class="rounded-2 object-fit-cover" style="width: 60px; height: 45px;" />
                                </td>
                                <td><code class="fw-bold text-purple">@t.Code</code></td>
                                <td class="fw-semibold">@t.Title</td>
                                <td><span class="badge bg-purple text-gold">@t.Category</span></td>
                                <td class="small">@t.Duration</td>
                                <td class="fw-bold text-purple">@t.BasePrice.ToString("N0") đ</td>
                                <td>
                                    <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                        @(t.IsActive ? "Mở bán" : "Tạm dừng")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" @onclick="() => EditTour(t)">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-2" @onclick="() => DeleteTour(t.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Thêm / Sửa Tour -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px;">
                <div class="modal-header bg-purple text-white">
                    <h5 class="modal-title font-serif fw-bold">@(editingTour.Id == 0 ? "Thêm Tour Du Lịch Mới" : "Chỉnh Sửa Thông Tin Tour")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="formModel" OnValidSubmit="SaveTour">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Mã Tour:</label>
                            <InputText class="form-control" @bind-Value="formModel.Code" placeholder="HT-XXXX" />
                            <ValidationMessage For="@(() => formModel.Code)" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Tên Tour:</label>
                            <InputText class="form-control" @bind-Value="formModel.Title" />
                            <ValidationMessage For="@(() => formModel.Title)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Danh Mục:</label>
                            <InputSelect class="form-select" @bind-Value="formModel.Category">
                                <option value="Di tích Cố Đô">Di tích Cố Đô</option>
                                <option value="Sinh thái & Đầm phá">Sinh thái & Đầm phá</option>
                                <option value="Thiên nhiên & Nghỉ dưỡng">Thiên nhiên &amp; Nghỉ dưỡng</option>
                                <option value="Sông Hương & Làng nghề">Sông Hương & Làng nghề</option>
                                <option value="Văn hóa & Ẩm thực">Văn hóa & Ẩm thực</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Giá Gốc (VNĐ):</label>
                            <InputNumber class="form-control" step="10000" @bind-Value="formModel.BasePrice" />
                            <ValidationMessage For="@(() => formModel.BasePrice)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Thời Lượng:</label>
                            <InputText class="form-control" @bind-Value="formModel.Duration" placeholder="1 Ngày" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Điểm Xuất Phát:</label>
                            <InputText class="form-control" @bind-Value="formModel.StartingLocation" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Link Ảnh Bìa (URL):</label>
                            <InputText class="form-control" @bind-Value="formModel.ImageUrl" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Đơn vị tổ chức (nếu có):</label>
                            <InputText class="form-control" @bind-Value="formModel.ProviderName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ngày kiểm tra giá (nếu có):</label>
                            <InputDate TValue="DateTime?" class="form-control" @bind-Value="formModel.PriceVerifiedAt" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Nguồn thông tin / giá (URL):</label>
                            <InputText class="form-control" @bind-Value="formModel.SourceUrl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Mô Tả Ngắn:</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="formModel.ShortDescription" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Điểm Nổi Bật (phân cách dấu chấm phẩy ;):</label>
                            <InputText class="form-control" @bind-Value="formModel.Highlights" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Lịch Trình Tóm Tắt (phân cách mũi tên ->):</label>
                            <InputText class="form-control" @bind-Value="formModel.Itinerary" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseModal">Hủy</button>
                    <button type="submit" class="btn btn-royal rounded-pill px-4">Lưu Tour</button>
                </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Tour> tours = new();
    private bool isLoading = true;
    private bool showModal = false;
    private Tour editingTour = new();
    private TourFormModel formModel = new();

    private sealed class TourFormModel
    {
        [Required(ErrorMessage = "Vui lòng nhập mã tour")]
        public string Code { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vui lòng nhập tên tour")]
        public string Title { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vui lòng chọn danh mục")]
        public string Category { get; set; } = string.Empty;
        [Range(0, double.MaxValue, ErrorMessage = "Giá tour không được âm")]
        public decimal BasePrice { get; set; }
        [Required(ErrorMessage = "Vui lòng nhập thời lượng")]
        public string Duration { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vui lòng nhập điểm xuất phát")]
        public string StartingLocation { get; set; } = string.Empty;
        [Required(ErrorMessage = "Vui lòng nhập đường dẫn ảnh")]
        public string ImageUrl { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public string SourceUrl { get; set; } = string.Empty;
        public DateTime? PriceVerifiedAt { get; set; }
        public string ShortDescription { get; set; } = string.Empty;
        public string Highlights { get; set; } = string.Empty;
        public string Itinerary { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTours();
    }

    private async Task LoadTours()
    {
        isLoading = true;
        try
        {
            var data = await ViewToursUseCase.ExecuteAsync(false);
            tours = data.ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        editingTour = new Tour
        {
            Code = $"HT-NEW{tours.Count + 1:D2}",
            ImageUrl = "/images/ngo-mon-gate.jpg",
            BasePrice = 500000,
            Duration = "1 Ngày",
            StartingLocation = "Trung tâm TP Huế",
            Highlights = "Xe đưa đón; Vé tham quan; HDV nhiệt tình",
            Itinerary = "08:00 Đón khách -> 11:30 Ăn trưa -> 17:00 Trả khách"
        };
        formModel = new TourFormModel { Code = editingTour.Code, Title = editingTour.Title, Category = editingTour.Category, BasePrice = editingTour.BasePrice, Duration = editingTour.Duration, StartingLocation = editingTour.StartingLocation, ImageUrl = editingTour.ImageUrl, ProviderName = editingTour.ProviderName, SourceUrl = editingTour.SourceUrl, PriceVerifiedAt = editingTour.PriceVerifiedAt, ShortDescription = editingTour.ShortDescription, Highlights = editingTour.Highlights, Itinerary = editingTour.Itinerary };
        showModal = true;
    }

    private void EditTour(Tour tour)
    {
        editingTour = new Tour
        {
            Id = tour.Id,
            Code = tour.Code,
            Title = tour.Title,
            Category = tour.Category,
            BasePrice = tour.BasePrice,
            Duration = tour.Duration,
            StartingLocation = tour.StartingLocation,
            ImageUrl = tour.ImageUrl,
            ProviderName = tour.ProviderName,
            SourceUrl = tour.SourceUrl,
            PriceVerifiedAt = tour.PriceVerifiedAt,
            ShortDescription = tour.ShortDescription,
            Description = tour.Description,
            Highlights = tour.Highlights,
            Itinerary = tour.Itinerary,
            IsActive = tour.IsActive
        };
        formModel = new TourFormModel { Code = tour.Code, Title = tour.Title, Category = tour.Category, BasePrice = tour.BasePrice, Duration = tour.Duration, StartingLocation = tour.StartingLocation, ImageUrl = tour.ImageUrl, ProviderName = tour.ProviderName, SourceUrl = tour.SourceUrl, PriceVerifiedAt = tour.PriceVerifiedAt, ShortDescription = tour.ShortDescription, Highlights = tour.Highlights, Itinerary = tour.Itinerary };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveTour()
    {
        editingTour.Code = formModel.Code;
        editingTour.Title = formModel.Title;
        editingTour.Category = formModel.Category;
        editingTour.BasePrice = formModel.BasePrice;
        editingTour.Duration = formModel.Duration;
        editingTour.StartingLocation = formModel.StartingLocation;
        editingTour.ImageUrl = formModel.ImageUrl;
        editingTour.ProviderName = formModel.ProviderName;
        editingTour.SourceUrl = formModel.SourceUrl;
        editingTour.PriceVerifiedAt = formModel.PriceVerifiedAt;
        editingTour.ShortDescription = formModel.ShortDescription;
        editingTour.Highlights = formModel.Highlights;
        editingTour.Itinerary = formModel.Itinerary;
        if (editingTour.Id == 0)
        {
            await ManageToursUseCase.AddTourAsync(editingTour);
        }
        else
        {
            await ManageToursUseCase.UpdateTourAsync(editingTour);
        }
        showModal = false;
        await LoadTours();
    }

    private async Task DeleteTour(int id)
    {
        await ManageToursUseCase.DeleteTourAsync(id);
        await LoadTours();
    }
}
