@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@using HueTour.CoreBusiness
@using HueTour.CoreBusiness.BusinessRules
@using HueTour.UseCases.PluginInterfaces.DataStore
@using HueTour.UseCases.Tours
@using HueTour.UseCases.Departures
@using HueTour.UseCases.Booking
@using HueTour.UseCases.Reports
@inject IViewToursUseCase ViewToursUseCase
@inject IManageDeparturesUseCase ManageDeparturesUseCase
@inject IManageBookingsUseCase ManageBookingsUseCase
@inject ITourBookingRepository TourBookingRepository
@inject IBuildAdminDashboardChartDataUseCase BuildAdminDashboardChartDataUseCase
@inject IJSRuntime JS

<PageTitle>Bảng Điều Khiển Tổng Quan - Cổng Quản Trị Huế Tour</PageTitle>

<div class="container-fluid py-4 px-md-5">
    <!-- 1. Header & Primary Action Toolbar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-purple text-gold fw-bold px-3 py-1 rounded-pill">
                    <i class="bi bi-shield-check me-1"></i>TRUNG TÂM ĐIỀU HÀNH TOUR HUẾ
                </span>
                <span class="text-muted small d-none d-sm-inline">
                    <i class="bi bi-clock me-1"></i>Cập nhật: @lastUpdated.ToString("HH:mm:ss - dd/MM/yyyy")
                </span>
            </div>
            <h2 class="font-serif fw-bold text-purple mb-0">Bảng Điều Khiển Tổng Quan (Dashboard)</h2>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 no-print">
            <button class="btn btn-outline-royal rounded-pill btn-sm px-3" @onclick="RefreshDataAsync" title="Tải lại số liệu">
                <i class="bi bi-arrow-clockwise me-1 @(isRefreshing ? "spin-animation" : "")"></i>Làm mới
            </button>
            <button class="btn btn-outline-royal rounded-pill btn-sm px-3" @onclick="PrintReportAsync" title="In báo cáo này">
                <i class="bi bi-printer me-1"></i>In báo cáo
            </button>
            <a href="/api/reports/bookings-csv" class="btn btn-success rounded-pill btn-sm px-3 shadow-sm" target="_blank" download>
                <i class="bi bi-file-earmark-excel-fill me-1"></i>Xuất Excel (CSV)
            </a>
            <div class="btn-group">
                <button type="button" class="btn btn-royal rounded-pill btn-sm px-3 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-plus-circle me-1"></i>Tác vụ nhanh
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item" href="admin/tours"><i class="bi bi-map me-2 text-primary"></i>Thêm tour mới</a></li>
                    <li><a class="dropdown-item" href="admin/departures"><i class="bi bi-calendar-plus me-2 text-warning"></i>Mở chuyến khởi hành</a></li>
                    <li><a class="dropdown-item" href="admin/bookings"><i class="bi bi-receipt me-2 text-success"></i>Duyệt đơn đặt tour</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="tours" target="_blank"><i class="bi bi-box-arrow-up-right me-2 text-muted"></i>Xem giao diện khách</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Alert Message Notification -->
    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="alert @actionMessageType alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi @(actionMessageType.Contains("success") ? "bi-check-circle-fill text-success" : "bi-info-circle-fill text-info") fs-5 me-2"></i>
                <div>@actionMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => actionMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- 2. Time Range & Quick Action Bar -->
    <div class="dash-action-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
        <div class="d-flex align-items-center gap-2">
            <span class="small fw-bold text-muted text-uppercase me-1"><i class="bi bi-funnel me-1"></i>Kỳ báo cáo:</span>
            <button class="dash-filter-pill @(timeFilter == DashboardTimeRange.All ? "active" : "")" @onclick="() => ChangeTimeFilter(DashboardTimeRange.All)">Tất cả</button>
            <button class="dash-filter-pill @(timeFilter == DashboardTimeRange.Month ? "active" : "")" @onclick="() => ChangeTimeFilter(DashboardTimeRange.Month)">Tháng này</button>
            <button class="dash-filter-pill @(timeFilter == DashboardTimeRange.Week ? "active" : "")" @onclick="() => ChangeTimeFilter(DashboardTimeRange.Week)">7 ngày qua</button>
            <button class="dash-filter-pill @(timeFilter == DashboardTimeRange.Today ? "active" : "")" @onclick="() => ChangeTimeFilter(DashboardTimeRange.Today)">Hôm nay</button>
        </div>

        <div class="d-flex align-items-center gap-2 small text-muted">
            <span class="badge bg-light text-dark border">
                <i class="bi bi-check2-circle text-success me-1"></i>Luật 1: Khóa &lt;24h tự động
            </span>
            <span class="badge bg-light text-dark border">
                <i class="bi bi-calculator text-primary me-1"></i>Luật 2: Vé Adult / Child / Infant
            </span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-purple" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="fw-bold text-purple mt-3">Đang tổng hợp dữ liệu điều hành...</h5>
            <p class="text-muted small">Vui lòng đợi giây lát trong khi hệ thống tính toán sơ đồ và báo cáo.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(chartLoadWarning))
        {
            <div class="alert alert-warning rounded-4 py-2 mb-4" role="status">
                <i class="bi bi-exclamation-triangle me-2"></i>@chartLoadWarning
            </div>
        }

        <!-- 3. KPI Cards -->
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6 col-12">
                <div class="dash-stat-card card-tours">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Tổng Tuyến Tour Mở Bán</span>
                            <h3 class="fw-bold text-purple mt-2 mb-1">@filteredToursCount</h3>
                            <div class="stat-badge-trend bg-success-subtle text-success">
                                <i class="bi bi-check2"></i> Đang hoạt động: @activeToursCount
                            </div>
                        </div>
                        <div class="stat-icon-wrap" style="background: rgba(24, 95, 87, 0.12); color: #185f57;">
                            <i class="bi bi-map-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="dash-stat-card card-departures">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Chuyến Khởi Hành</span>
                            <h3 class="fw-bold text-gold mt-2 mb-1">@filteredDeparturesCount</h3>
                            <div class="stat-badge-trend bg-warning-subtle text-warning">
                                <i class="bi bi-clock-history"></i> Sắp đi: @upcomingDeparturesCount
                            </div>
                        </div>
                        <div class="stat-icon-wrap" style="background: rgba(193, 139, 47, 0.12); color: #c18b2f;">
                            <i class="bi bi-calendar2-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="dash-stat-card card-bookings">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Đơn Đặt Chỗ (Booking)</span>
                            <h3 class="fw-bold text-primary mt-2 mb-1">@filteredBookingsCount</h3>
                            <div class="stat-badge-trend bg-info-subtle text-info">
                                <i class="bi bi-hourglass-split"></i> Chờ duyệt: @pendingBookingsCount
                            </div>
                        </div>
                        <div class="stat-icon-wrap" style="background: rgba(2, 132, 199, 0.12); color: #0284c7;">
                            <i class="bi bi-ticket-perforated-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="dash-stat-card card-revenue">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Doanh Thu Ghi Nhận</span>
                            <h3 class="fw-bold text-success mt-2 mb-1">@filteredRevenue.ToString("N0") <small class="fs-6">đ</small></h3>
                            <div class="stat-badge-trend bg-success-subtle text-success">
                                <i class="bi bi-arrow-up-right"></i> Vé xác nhận: @confirmedBookingsCount
                            </div>
                        </div>
                        <div class="stat-icon-wrap" style="background: rgba(22, 163, 74, 0.12); color: #16a34a;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. SƠ ĐỒ & BIỂU ĐỒ TRỰC QUAN (CHARTS & DIAGRAMS SECTION) -->
        <div class="row g-4 mb-4">
            <!-- Biểu đồ 1: Doanh Thu & Số Đơn Đặt Theo Kỳ -->
            <div class="col-xl-8 col-12">
                <div class="dash-chart-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <span class="badge bg-purple text-gold small mb-1">SƠ ĐỒ 1</span>
                            <h5 class="fw-bold text-purple mb-0">
                                <i class="bi bi-graph-up me-2 text-gold"></i>Doanh Thu Xác Nhận &amp; Đơn Đặt Theo Thời Gian
                                <span class="d-block text-muted small mt-1">@trendPeriodCaption</span>
                            </h5>
                        </div>
                        <div class="btn-group btn-group-sm mt-2 mt-sm-0" role="group">
                            <button type="button" class="btn @(chartViewMode == "all" ? "btn-royal" : "btn-outline-royal")" @onclick='() => ChangeChartViewMode("all")'>
                                Cả hai
                            </button>
                            <button type="button" class="btn @(chartViewMode == "revenue" ? "btn-royal" : "btn-outline-royal")" @onclick='() => ChangeChartViewMode("revenue")'>
                                Doanh thu
                            </button>
                            <button type="button" class="btn @(chartViewMode == "orders" ? "btn-royal" : "btn-outline-royal")" @onclick='() => ChangeChartViewMode("orders")'>
                                Số đơn
                            </button>
                        </div>
                    </div>

                    <div class="chart-canvas-container">
                        @if (HasTrendChartData)
                        {
                            <canvas id="hue-revenue-chart" aria-label="Biểu đồ doanh thu xác nhận và số đơn theo thời gian"></canvas>
                        }
                        else
                        {
                            <div class="dash-chart-empty">
                                <i class="bi bi-graph-down-arrow"></i>
                                <span>Chưa có đơn đặt tour trong kỳ này.</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top small text-muted">
                        <span><i class="bi bi-info-circle me-1"></i>Doanh thu chỉ tính đơn đã xác nhận hoặc hoàn thành; số đơn tính mọi trạng thái.</span>
                        <span class="fw-bold text-purple">Doanh thu đã ghi nhận: @chartData.TrendRevenue.Sum().ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <!-- Biểu đồ 2: Cơ Cấu Trạng Thái Đơn Hàng (Donut Chart) -->
            <div class="col-xl-4 col-12">
                <div class="dash-chart-card">
                    <div class="border-bottom pb-3 mb-3">
                        <span class="badge bg-purple text-gold small mb-1">SƠ ĐỒ 2</span>
                        <h5 class="fw-bold text-purple mb-0">
                            <i class="bi bi-pie-chart-fill me-2 text-gold"></i>Cơ Cấu Trạng Thái Đơn
                        </h5>
                    </div>

                    <div class="chart-canvas-donut">
                        @if (HasStatusChartData)
                        {
                            <canvas id="hue-status-chart" aria-label="Biểu đồ cơ cấu trạng thái đơn đặt tour"></canvas>
                        }
                        else
                        {
                            <div class="dash-chart-empty">
                                <i class="bi bi-inbox"></i>
                                <span>Chưa có dữ liệu đơn đặt.</span>
                            </div>
                        }
                    </div>

                    <div class="row g-2 text-center mt-2 pt-2 border-top small">
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <span class="text-warning fw-bold d-block fs-6">@StatusCount(0)</span>
                                <span class="text-muted">Chờ xử lý</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <span class="text-success fw-bold d-block fs-6">@StatusCount(1)</span>
                                <span class="text-muted">Đã xác nhận</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <span class="text-primary fw-bold d-block fs-6">@StatusCount(2)</span>
                                <span class="text-muted">Hoàn thành</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <span class="text-danger fw-bold d-block fs-6">@StatusCount(3)</span>
                                <span class="text-muted">Đã hủy</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 3: Công suất các chuyến sắp khởi hành -->
        <div class="row g-4 mb-4">
            <div class="col-xl-7 col-12">
                <div class="dash-chart-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <span class="badge bg-purple text-gold small mb-1">SƠ ĐỒ 3</span>
                            <h5 class="fw-bold text-purple mb-0">
                                <i class="bi bi-bar-chart-steps me-2 text-gold"></i>Công Suất Chuyến Sắp Khởi Hành
                            </h5>
                            <span class="d-block text-muted small mt-1">6 chuyến gần nhất · số ghế đã đặt và còn trống</span>
                        </div>
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-people-fill text-gold me-1"></i>Công suất ghế thực tế
                        </span>
                    </div>

                    <div class="chart-canvas-container chart-canvas-compact">
                        @if (HasOccupancyChartData)
                        {
                            <canvas id="hue-occupancy-chart" aria-label="Số ghế đã đặt và còn trống trên các tour sắp khởi hành"></canvas>
                        }
                        else
                        {
                            <div class="dash-chart-empty">
                                <i class="bi bi-calendar2-x"></i>
                                <span>Chưa có chuyến sắp khởi hành để thống kê.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Biểu đồ 4: Doanh thu đã xác nhận theo danh mục -->
            <div class="col-xl-5 col-12">
                <div class="dash-chart-card">
                    <div class="border-bottom pb-3 mb-3">
                        <span class="badge bg-purple text-gold small mb-1">SƠ ĐỒ 4</span>
                        <h5 class="fw-bold text-purple mb-0">
                            <i class="bi bi-tags-fill me-2 text-gold"></i>Doanh Thu Theo Danh Mục
                        </h5>
                        <span class="d-block text-muted small mt-1">Chỉ tính đơn đã xác nhận hoặc hoàn thành.</span>
                    </div>
                    <div class="chart-canvas-container chart-canvas-compact">
                        @if (HasCategoryRevenueData)
                        {
                            <canvas id="hue-category-revenue-chart" aria-label="Doanh thu đã xác nhận theo danh mục tour"></canvas>
                        }
                        else
                        {
                            <div class="dash-chart-empty">
                                <i class="bi bi-currency-exchange"></i>
                                <span>Chưa có doanh thu đã xác nhận trong kỳ này.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. BẢNG THỐNG KÊ BÁO CÁO (DETAILED STATISTICAL REPORT TABLES) -->
        <div class="dash-report-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom pb-3 mb-3">
                <div>
                    <span class="badge bg-purple text-gold mb-1">BÁO CÁO 1</span>
                    <h5 class="fw-bold text-purple mb-0">
                        <i class="bi bi-table me-2 text-gold"></i>Bảng Báo Cáo Hiệu Suất &amp; Doanh Thu Theo Tuyến Tour Huế
                    </h5>
                    <p class="text-muted small mb-0">Đo lường công suất ghế, số chuyến thực tế và doanh số tích lũy của từng tuyến điểm.</p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm tên tour..." @bind="tourSearchText" @bind:event="oninput" />
                    </div>
                    <select class="form-select form-select-sm" style="max-width: 180px;" @bind="selectedCategory">
                        <option value="All">Tất cả danh mục</option>
                        @foreach (var cat in availableCategories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table dash-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã / Tuyến Tour</th>
                            <th>Danh Mục</th>
                            <th class="text-end">Giá Gốc</th>
                            <th class="text-center">Số Chuyến</th>
                            <th>Công Suất Ghế (Đã bán / Sức chứa)</th>
                            <th class="text-end">Doanh Thu</th>
                            <th class="text-center">Đánh Giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filteredTourReports.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>Không có tour nào khớp với bộ lọc tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in filteredTourReports)
                            {
                                double occupancyPct = report.TotalCapacity > 0 ? (double)report.BookedSeats / report.TotalCapacity * 100 : 0;
                                string progressColor = occupancyPct >= 70 ? "#16a34a" : occupancyPct >= 40 ? "#c18b2f" : "#0284c7";
                                string evalBadgeClass = occupancyPct >= 70 ? "bg-success" : occupancyPct >= 40 ? "bg-warning text-dark" : "bg-secondary";
                                string evalText = occupancyPct >= 70 ? "Bán chạy" : occupancyPct >= 40 ? "Ổn định" : "Cần đẩy mạnh";

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@report.ImageUrl" alt="@report.TourTitle" class="rounded-2 object-fit-cover shadow-sm" style="width: 48px; height: 36px;" />
                                            <div>
                                                <a href="/tours/@report.TourId" target="_blank" class="fw-bold text-purple text-decoration-none d-block line-clamp-1" style="max-width: 280px;">
                                                    @report.TourTitle
                                                </a>
                                                <small class="text-muted"><code>@report.TourCode</code></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-purple text-gold">@report.Category</span></td>
                                    <td class="text-end fw-semibold">@report.BasePrice.ToString("N0") đ</td>
                                    <td class="text-center fw-bold text-purple">@report.DepartureCount</td>
                                    <td style="min-width: 180px;">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span><strong>@report.BookedSeats</strong> / @report.TotalCapacity ghế</span>
                                            <span class="fw-bold">@occupancyPct.ToString("F1")%</span>
                                        </div>
                                        <div class="occupancy-progress">
                                            <div class="occupancy-bar-fill" style="width: @occupancyPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @progressColor;"></div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-success">@report.Revenue.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="badge @evalBadgeClass rounded-pill px-3 py-1 small">@evalText</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- BÁO CÁO 2: Phân Tích Cơ Cấu Khách Hàng & Doanh Thu Theo Luật 2 -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6 col-12">
                <div class="dash-report-card h-100">
                    <div class="border-bottom pb-3 mb-3">
                        <span class="badge bg-purple text-gold mb-1">BÁO CÁO 2 (LUẬT 2)</span>
                        <h5 class="fw-bold text-purple mb-0">
                            <i class="bi bi-people me-2 text-gold"></i>Cơ Cấu Khách Hàng Theo Quy Định Giá
                        </h5>
                        <p class="text-muted small mb-0">Thống kê loại khách áp dụng theo chính sách vé Huế Tour.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table dash-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Loại Vé</th>
                                    <th>Mức Giá Áp Dụng</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Doanh Số Ước Tính</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <i class="bi bi-person-fill text-purple me-1"></i>
                                        <strong>Người lớn (Adult)</strong>
                                    </td>
