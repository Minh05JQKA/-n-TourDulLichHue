@code {
    // Master data
    private List<Tour> allTours = new();
    private List<Departure> allDepartures = new();
    private List<TourBooking> allBookings = new();

    // KPI Counters
    private int filteredToursCount = 0;
    private int activeToursCount = 0;
    private int filteredDeparturesCount = 0;
    private int upcomingDeparturesCount = 0;
    private int filteredBookingsCount = 0;
    private int pendingBookingsCount = 0;
    private int confirmedBookingsCount = 0;
    private decimal filteredRevenue = 0;

    // Pricing Rule 2 Breakdown
    private int adultTicketCount = 0;
    private decimal adultRevenue = 0;
    private int childTicketCount = 0;
    private decimal childRevenue = 0;
    private int infantTicketCount = 0;

    // Filters and Display
    private DashboardTimeRange timeFilter = DashboardTimeRange.All;
    private string chartViewMode = "all";
    private string bookingStatusFilter = "All";
    private string tourSearchText = "";
    private string selectedCategory = "All";
    private List<string> availableCategories = new();

    // Data lists for display
    private List<TourBooking> displayedRecentBookings = new();
    private List<Departure> upcomingDepartures = new();
    private List<TourReportItem> tourReports = new();
    private AdminDashboardChartData chartData = new();

    // Quick View Modal
    private TourBooking? selectedBooking;
    private List<PassengerTicket> selectedBookingTickets = new();

    // State
    private bool isLoading = true;
    private bool isRefreshing = false;
    private bool chartsNeedRender = true;
    private string? actionMessage;
    private string? chartLoadWarning;
    private string actionMessageType = "alert-success";
    private DateTime lastUpdated = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && chartsNeedRender)
        {
            chartsNeedRender = false;
            await RenderAllChartsAsync();
        }
    }

    private async Task LoadAllDataAsync()
    {
        isLoading = true;
        try
        {
            var toursTask = ViewToursUseCase.ExecuteAsync(false);
            var departuresTask = ManageDeparturesUseCase.GetAllDeparturesAsync();
            var bookingsTask = ManageBookingsUseCase.GetAllBookingsAsync();

            await Task.WhenAll(toursTask, departuresTask, bookingsTask);

            allTours = (await toursTask).ToList();
            allDepartures = (await departuresTask).ToList();
            allBookings = (await bookingsTask).ToList();

            availableCategories = allTours
                .Select(t => t.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            ComputeMetrics();
            lastUpdated = DateTime.Now;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ComputeMetrics()
    {
        // 1. Time filtering
        DateTime cutoffDate = timeFilter switch
        {
            DashboardTimeRange.Today => DateTime.Today,
            DashboardTimeRange.Week => DateTime.Today.AddDays(-6),
            DashboardTimeRange.Month => new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
            _ => DateTime.MinValue
        };

        var currentBookings = allBookings
            .Where(b => timeFilter == DashboardTimeRange.All || b.BookingDate >= cutoffDate)
            .ToList();

        filteredToursCount = allTours.Count;
        activeToursCount = allTours.Count(t => t.IsActive);

        filteredDeparturesCount = allDepartures.Count;
        upcomingDepartures = allDepartures
            .Where(d => d.DepartureDate >= DateTime.Now)
            .OrderBy(d => d.DepartureDate)
            .Take(5)
            .ToList();
        upcomingDeparturesCount = allDepartures.Count(d => d.DepartureDate >= DateTime.Now);

        filteredBookingsCount = currentBookings.Count;
        pendingBookingsCount = currentBookings.Count(b => b.Status == TourBookingStatus.Pending);
        confirmedBookingsCount = currentBookings.Count(b => b.Status == TourBookingStatus.Confirmed);

        filteredRevenue = currentBookings
            .Where(b => b.Status is TourBookingStatus.Confirmed or TourBookingStatus.Completed)
            .Sum(b => b.TotalAmount);

        // 2. Recent Bookings list with status filter
        displayedRecentBookings = currentBookings
            .Where(b => bookingStatusFilter == "All" || b.Status == bookingStatusFilter)
            .OrderByDescending(b => b.BookingDate)
            .Take(6)
            .ToList();

        // 3. Tour Performance Report Table
        tourReports = allTours.Select(t =>
        {
            var deps = allDepartures.Where(d => d.TourId == t.Id).ToList();
            int depCount = deps.Count;
            int totalCap = deps.Sum(d => d.MaxCapacity);
            int booked = deps.Sum(d => d.BookedSeats);
            decimal rev = currentBookings
                .Where(b => b.Departure?.TourId == t.Id &&
                            b.Status is TourBookingStatus.Confirmed or TourBookingStatus.Completed)
                .Sum(b => b.TotalAmount);

            return new TourReportItem
            {
                TourId = t.Id,
                TourCode = t.Code,
                TourTitle = t.Title,
                Category = t.Category,
                BasePrice = t.BasePrice,
                ImageUrl = t.ImageUrl,
                DepartureCount = depCount,
                TotalCapacity = totalCap,
                BookedSeats = booked,
                Revenue = rev
            };
        }).OrderByDescending(r => r.Revenue).ToList();

        // 4. Passenger Breakdown (Rule 2) Estimation from bookings
        CalculateTicketBreakdown(currentBookings);

        chartData = BuildAdminDashboardChartDataUseCase.Execute(
            allTours,
            allDepartures,
            allBookings,
            timeFilter,
            DateTime.Now);
        chartsNeedRender = true;
    }

    private void CalculateTicketBreakdown(List<TourBooking> bookings)
    {
        // Estimate passenger counts and revenues based on Rule 2 (Adult 100%, Child 50%, Infant 0)
        adultTicketCount = 0;
        childTicketCount = 0;
        infantTicketCount = 0;
        adultRevenue = 0;
        childRevenue = 0;

        foreach (var b in bookings.Where(b => b.Status != TourBookingStatus.Cancelled))
        {
            decimal basePrice = b.Departure?.Tour?.BasePrice ?? 500000;
            if (basePrice <= 0) basePrice = 500000;

            // Approximate breakdown if tickets are not yet loaded in memory
            int estimatedAdults = Math.Max(1, (int)(b.TotalAmount / basePrice));
            decimal rem = b.TotalAmount - (estimatedAdults * basePrice);
            int estimatedChildren = rem > 0 ? Math.Max(1, (int)(rem / (basePrice * 0.5m))) : 0;
            int estimatedInfants = b.Notes?.Contains("bé", StringComparison.OrdinalIgnoreCase) == true ? 1 : 0;

            adultTicketCount += estimatedAdults;
            adultRevenue += estimatedAdults * basePrice;
            childTicketCount += estimatedChildren;
            childRevenue += estimatedChildren * (basePrice * 0.5m);
            infantTicketCount += estimatedInfants;
        }
    }

    private List<TourReportItem> filteredTourReports => tourReports
        .Where(r => (selectedCategory == "All" || r.Category == selectedCategory) &&
                    (string.IsNullOrWhiteSpace(tourSearchText) || r.TourTitle.Contains(tourSearchText, StringComparison.OrdinalIgnoreCase) || r.TourCode.Contains(tourSearchText, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private async Task RenderAllChartsAsync()
    {
        var previousWarning = chartLoadWarning;
        try
        {
            bool chartsRendered = true;

            if (HasTrendChartData)
            {
                chartsRendered &= await JS.InvokeAsync<bool>("hueDashboardCharts.renderRevenueChart",
                    "hue-revenue-chart", chartData.TrendLabels, chartData.TrendRevenue, chartData.TrendBookings, chartViewMode);
            }
            else
            {
                await JS.InvokeVoidAsync("hueDashboardCharts.destroyChart", "hue-revenue-chart");
            }

            if (HasStatusChartData)
            {
                chartsRendered &= await JS.InvokeAsync<bool>("hueDashboardCharts.renderStatusChart",
                    "hue-status-chart", chartData.StatusLabels, chartData.StatusCounts,
                    new[] { "#f59e0b", "#16a34a", "#0284c7", "#e11d48" });
            }
            else
            {
                await JS.InvokeVoidAsync("hueDashboardCharts.destroyChart", "hue-status-chart");
            }

            if (HasOccupancyChartData)
            {
                chartsRendered &= await JS.InvokeAsync<bool>("hueDashboardCharts.renderOccupancyChart",
                    "hue-occupancy-chart", chartData.OccupancyLabels,
                    chartData.OccupancyBookedSeats, chartData.OccupancyAvailableSeats);
            }
            else
            {
                await JS.InvokeVoidAsync("hueDashboardCharts.destroyChart", "hue-occupancy-chart");
            }

            if (HasCategoryRevenueData)
            {
                chartsRendered &= await JS.InvokeAsync<bool>("hueDashboardCharts.renderCategoryRevenueChart",
                    "hue-category-revenue-chart", chartData.CategoryLabels, chartData.CategoryRevenue);
            }
            else
            {
                await JS.InvokeVoidAsync("hueDashboardCharts.destroyChart", "hue-category-revenue-chart");
            }

            chartLoadWarning = chartsRendered
                ? null
                : "Không tải được thư viện biểu đồ. Vui lòng tải lại trang để thử lại.";
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException)
        {
            chartLoadWarning = "Biểu đồ chưa thể hiển thị. Vui lòng làm mới trang hoặc thử lại sau.";
        }

        if (!string.Equals(previousWarning, chartLoadWarning, StringComparison.Ordinal))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private string trendPeriodCaption => timeFilter switch
    {
        DashboardTimeRange.Month => "Từ đầu tháng đến hiện tại",
        DashboardTimeRange.Week => "7 ngày gần nhất",
        DashboardTimeRange.Today => "Hôm nay · chia theo khung 2 giờ",
        _ => "6 tháng gần nhất"
    };

    private bool HasTrendChartData => chartData.TrendBookings.Any(count => count > 0);
    private bool HasStatusChartData => chartData.StatusCounts.Any(count => count > 0);
    private bool HasOccupancyChartData => chartData.OccupancyLabels.Count > 0;
    private bool HasCategoryRevenueData => chartData.CategoryRevenue.Any(revenue => revenue > 0);

    private int StatusCount(int index) => chartData.StatusCounts.Count > index ? chartData.StatusCounts[index] : 0;

    private void ChangeTimeFilter(DashboardTimeRange filter)
    {
        timeFilter = filter;
        ComputeMetrics();
    }

    private void ChangeChartViewMode(string mode)
    {
        chartViewMode = mode;
        chartsNeedRender = true;
    }

    private void FilterBookingsByStatus(string status)
    {
        bookingStatusFilter = status;
        ComputeMetrics();
    }

    private async Task RefreshDataAsync()
    {
        isRefreshing = true;
        await LoadAllDataAsync();
        isRefreshing = false;
        actionMessage = "Đã cập nhật dữ liệu mới nhất từ hệ thống.";
        actionMessageType = "alert-success";
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("hueDashboardCharts.printReport");
    }

    private async Task QuickConfirmBooking(int bookingId)
    {
        await ManageBookingsUseCase.ConfirmBookingAsync(bookingId);
        actionMessage = $"Đã duyệt thành công đơn booking #{bookingId}.";
        actionMessageType = "alert-success";
        await LoadAllDataAsync();
        if (selectedBooking?.Id == bookingId)
        {
            selectedBooking.Status = TourBookingStatus.Confirmed;
        }
    }

    private async Task QuickCancelBooking(int bookingId)
    {
        try
        {
            var res = await ManageBookingsUseCase.CancelBookingAsync(bookingId);
            if (res.IsSuccess)
            {
                actionMessage = "Đã hủy đơn thành công và tự động hoàn trả số chỗ theo Luật 1.";
                actionMessageType = "alert-warning";
            }
            else
            {
                actionMessage = res.ErrorMessage;
                actionMessageType = "alert-danger";
            }
        }
        catch
        {
            actionMessage = BookingBusinessRules.SeatReleaseFailedMessage;
            actionMessageType = "alert-danger";
        }
        await LoadAllDataAsync();
        if (selectedBooking?.Id == bookingId)
        {
            selectedBooking.Status = TourBookingStatus.Cancelled;
        }
    }

    private async Task OpenQuickViewModal(TourBooking b)
    {
        selectedBooking = b;
        selectedBookingTickets.Clear();
        try
        {
            var tickets = await TourBookingRepository.GetTicketsByBookingIdAsync(b.Id);
            selectedBookingTickets = tickets.ToList();
        }
        catch
        {
            // Fallback sample ticket display
        }
    }

    private void CloseQuickViewModal()
    {
        selectedBooking = null;
        selectedBookingTickets.Clear();
    }

