        public decimal BasePrice { get; set; }
        public string? ImageUrl { get; set; }
        public int DepartureCount { get; set; }
        public int TotalCapacity { get; set; }
        public int BookedSeats { get; set; }
        public decimal Revenue { get; set; }
    }
