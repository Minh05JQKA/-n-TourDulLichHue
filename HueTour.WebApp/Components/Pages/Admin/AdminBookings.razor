@page "/admin/bookings"
@attribute [Authorize(Roles = "Admin")]
@using HueTour.CoreBusiness
@using HueTour.CoreBusiness.BusinessRules
@inject IManageBookingsUseCase ManageBookings

<PageTitle>Quản lý đơn đặt tour - Hue Tour</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-purple text-gold">ĐIỀU HÀNH</span>
            <h2 class="font-serif fw-bold text-purple mb-0">Đơn đặt tour</h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/api/reports/bookings.xlsx" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm fw-bold" download>
                <i class="bi bi-file-earmark-excel-fill me-1"></i>Xuất Excel (.xlsx)
            </a>
            <a href="/api/reports/bookings-csv" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold" download>
                <i class="bi bi-filetype-csv me-1"></i>Xuất CSV
            </a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info">@message</div> }
    <div class="card border-0 shadow-sm p-4" style="border-radius: 18px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Tour / Ngày đi</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tác vụ xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in bookings)
                    {
                        <tr>
                            <td class="fw-bold text-purple">
                                <a href="/booking-confirmation/@booking.BookingCode" target="_blank" class="text-purple text-decoration-none">
                                    @booking.BookingCode
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@booking.Customer?.FullName</div>
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i>@booking.Customer?.PhoneNumber</small>
                                @if (!string.IsNullOrWhiteSpace(booking.SpecialRequests))
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"
                                              title="@booking.SpecialRequests">
                                            <i class="bi bi-building-check me-1"></i>Có yêu cầu đặc biệt
                                        </span>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 260px;">@booking.Departure?.Tour?.Title</div>
                                <small class="text-muted"><i class="bi bi-calendar me-1"></i>@booking.Departure?.DepartureDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td class="small">@booking.BookingDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-purple">@booking.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(booking.Status == TourBookingStatus.Confirmed ? "bg-success" : booking.Status == TourBookingStatus.Cancelled ? "bg-danger" : booking.Status == TourBookingStatus.Completed ? "bg-primary" : "bg-warning text-dark")">
                                    @booking.Status
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (booking.Status == TourBookingStatus.Pending)
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-3 me-1" @onclick="() => Confirm(booking.Id)">
                                        <i class="bi bi-check-lg me-1"></i>Xác nhận
                                    </button>
                                }
                                @if (booking.Status is TourBookingStatus.Pending or TourBookingStatus.Confirmed)
                                {
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 me-1" @onclick="() => Cancel(booking.Id)">
                                        <i class="bi bi-x-lg me-1"></i>Hủy đơn
                                    </button>
                                }
                                @if (booking.Status == TourBookingStatus.Confirmed)
                                {
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => Complete(booking.Id)">
                                        <i class="bi bi-flag me-1"></i>Hoàn tất
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<TourBooking> bookings = new();
    private string? message;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => bookings = (await ManageBookings.GetAllBookingsAsync()).ToList();
    private async Task Confirm(int id) { await ManageBookings.ConfirmBookingAsync(id); message = "Đã xác nhận đơn đặt tour."; await Load(); }
    private async Task Cancel(int id)
    {
        try
        {
            var result = await ManageBookings.CancelBookingAsync(id);
            message = result.IsSuccess ? "Đã hủy đơn và cập nhật số chỗ." : result.ErrorMessage;
        }
        catch
        {
            message = BookingBusinessRules.SeatReleaseFailedMessage;
        }
        await Load();
    }
    private async Task Complete(int id) { await ManageBookings.CompleteBookingAsync(id); message = "Đã hoàn tất đơn."; await Load(); }
}
