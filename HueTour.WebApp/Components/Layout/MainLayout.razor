@using HueTour.CoreBusiness.BusinessRules
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="d-flex flex-column min-vh-100">
    <!-- Main Navbar -->
    <header class="navbar navbar-expand-lg navbar-dark site-header sticky-top py-3">
        <div class="container-fluid px-xl-5 px-lg-4 px-3">
            <a class="navbar-brand d-flex align-items-center" href="/" aria-label="HueTour - Trang chủ">
                <img class="brand-logo" src="/images/hue-tour-logo.svg" alt="HueTour — Chạm vào miền di sản" />
            </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#hueNavbar" aria-controls="hueNavbar" aria-expanded="false" aria-label="Mở menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="hueNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="" Match="NavLinkMatch.All">
                            <i class="bi bi-house-door me-1"></i>Trang Chủ
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="tours">
                            <i class="bi bi-compass me-1"></i>Tour Du Lịch
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="kham-pha">
                            <i class="bi bi-map me-1"></i>Khám Phá Huế
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="am-thuc">
                            <i class="bi bi-cup-hot me-1"></i>Ẩm Thực
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="my-booking">
                            <i class="bi bi-ticket-perforated me-1"></i>Tra Cứu Vé
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 text-warning fw-semibold" href="ai-consultant">
                            <i class="bi bi-stars me-1"></i>Gợi ý hành trình
                        </NavLink>
                    </li>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <li class="nav-item dropdown admin-nav-item">
                                <a class="admin-portal-badge nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="admin-shield-icon"><i class="bi bi-shield-check"></i></span>
                                    <span>Quản Trị Viên</span>
                                    <span class="admin-live-dot" title="Hệ thống trực tuyến"></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end admin-dropdown-menu shadow-lg">
                                    <div class="admin-dropdown-header">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-crown-fill text-gold me-1"></i>
                                                <span class="header-brand">HỆ THỐNG ĐIỀU HÀNH HUẾ TOUR</span>
                                            </div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small py-1 px-2">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Trực tuyến
                                            </span>
                                        </div>
                                        <div class="header-title">Cổng Quản Trị Cố Đô</div>
                                    </div>
                                    <ul class="admin-dropdown-list">
                                        <li>
                                            <a class="admin-menu-item-link" href="admin">
                                                <div class="admin-item-icon-wrap admin-icon-gold">
                                                    <i class="bi bi-speedometer2"></i>
                                                </div>
                                                <div class="admin-item-content">
                                                    <div class="admin-item-title">Tổng quan Dashboard</div>
                                                    <div class="admin-item-sub">Chỉ số KPI, sơ đồ biểu đồ &amp; báo cáo</div>
                                                </div>
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="admin-menu-item-link" href="admin/tours">
                                                <div class="admin-item-icon-wrap admin-icon-jade">
                                                    <i class="bi bi-map-fill"></i>
                                                </div>
                                                <div class="admin-item-content">
                                                    <div class="admin-item-title">Quản lý Tuyến Điểm Tour</div>
                                                    <div class="admin-item-sub">Thêm mới tour, biên tập nội dung, giá vé</div>
                                                </div>
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="admin-menu-item-link" href="admin/departures">
                                                <div class="admin-item-icon-wrap admin-icon-amber">
                                                    <i class="bi bi-calendar2-check-fill"></i>
                                                </div>
                                                <div class="admin-item-content">
                                                    <div class="admin-item-title">Quản lý Chuyến Khởi Hành</div>
                                                    <div class="admin-item-sub">Lịch trình khởi hành, kiểm soát chỗ (Luật 1)</div>
                                                </div>
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="admin-menu-item-link" href="admin/bookings">
                                                <div class="admin-item-icon-wrap admin-icon-purple">
                                                    <i class="bi bi-receipt-cutoff"></i>
                                                </div>
                                                <div class="admin-item-content">
                                                    <div class="admin-item-title">Quản lý Đơn Đặt Tour</div>
                                                    <div class="admin-item-sub">Tiếp nhận đơn, duyệt thanh toán &amp; hủy đơn</div>
                                                </div>
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="admin-dropdown-footer">
                                        <a href="admin" class="btn-royal-gold">
                                            <i class="bi bi-graph-up-arrow me-1"></i>Vào Bảng Điều Khiển
                                        </a>
                                        <a href="/api/reports/bookings-csv" class="btn-outline-royal-gold" target="_blank" download>
                                            <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
                                        </a>
                                    </div>
                                </div>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>

                <!-- User Auth Area (K4.1) -->
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <button class="theme-toggle btn btn-outline-light btn-sm rounded-pill px-3"
                            type="button"
                            @onclick="ToggleThemeAsync"
                            aria-label="@(isDarkMode ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối")"
                            aria-pressed="@isDarkMode.ToString().ToLowerInvariant()"
                            title="@(isDarkMode ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối")">
                        <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill")" aria-hidden="true"></i>
                        <span>@(isDarkMode ? "Sáng" : "Tối")</span>
                    </button>
                    <AuthorizeView>
                        <Authorized>
                        <span class="user-greeting text-light small me-2">
                                <i class="bi bi-person-circle text-gold me-1"></i>@context.User.Identity?.Name
                            </span>
                            <a href="/logout" class="btn btn-outline-light btn-sm rounded-pill px-3 text-nowrap">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn btn-gold btn-sm rounded-pill px-3 shadow-sm text-nowrap">
                                <i class="bi bi-person-fill me-1"></i>Đăng nhập
                            </a>
                            <a href="/register" class="btn btn-outline-light btn-sm rounded-pill px-3 text-nowrap ms-1">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <TravelAssistantWidget />

    <!-- Footer Hoàng Cung Huế -->
    <footer class="footer-royal">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img class="brand-emblem" src="/images/hue-tour-emblem.svg" alt="" />
                        <h5 class="navbar-brand-title text-white mb-0">HUẾ TOUR BOOKING</h5>
                    </div>
                    <p class="small text-muted mb-3">
                        Đồ án đặt tour khám phá di sản, làng nghề, ẩm thực và cảnh quan xứ Huế.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-purple border border-secondary text-gold">Đại Nội</span>
                        <span class="badge bg-purple border border-secondary text-gold">Lăng Tẩm</span>
                        <span class="badge bg-purple border border-secondary text-gold">Tam Giang</span>
                        <span class="badge bg-purple border border-secondary text-gold">Ca Huế</span>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">
                        <i class="bi bi-check2-circle text-gold me-2"></i>Quy Định & Luật Nghiệp Vụ (K1.3)
                    </h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <strong class="text-gold">Luật 1:</strong> Tổng hành khách của chuyến &le; số chỗ tối đa; Hệ thống tự động khóa đặt vé trước giờ khởi hành @BookingBusinessRules.CutoffHoursBeforeDeparture tiếng.
                        </li>
                        <li>
                            <strong class="text-gold">Luật 2:</strong> Giá vé tính theo loại khách: Người lớn 100%, Trẻ em 5-11 tuổi 50%, Em bé dưới 5 tuổi miễn phí; Tổng booking = &Sigma; vé.
                        </li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">
                        <i class="bi bi-info-circle text-gold me-2"></i>Thông tin dữ liệu
                    </h6>
                    <p class="small mb-2">Đây là website capstone trình diễn luồng tìm kiếm, đặt chỗ và quản trị tour.</p>
                    <p class="small mb-0">Giá, giờ khởi hành và số chỗ là dữ liệu mẫu; vui lòng xác nhận với đơn vị vận hành trước khi khởi hành.</p>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 text-center small text-muted">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <span>© 2026 Huế Tour · Đồ án Capstone ECO2415</span>
                    <a class="footer-source-link" href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Nguồn và ghi công ảnh</a>
                </div>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            isDarkMode = await JS.InvokeAsync<bool>("hueTheme.isDark");
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            // Keep the default light theme if browser storage is unavailable.
        }
    }

    private async Task ToggleThemeAsync()
    {
        isDarkMode = await JS.InvokeAsync<bool>("hueTheme.toggle");
    }
}
