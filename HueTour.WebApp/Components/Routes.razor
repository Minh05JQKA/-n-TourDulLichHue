@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="container py-5 text-center">
                        <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 500px; border-radius: 16px;">
                            <div class="display-1 text-danger mb-3">
                                <i class="bi bi-shield-lock"></i> 🔒
                            </div>
                            <h3 class="fw-bold text-danger">Truy Cập Bị Từ Chối</h3>
                            <p class="text-muted">Bạn không có quyền quản trị hoặc chưa đăng nhập vào hệ thống để xem trang này.</p>
                            <div class="d-flex justify-content-center gap-2 mt-3">
                                <a href="/login" class="btn btn-primary px-4 rounded-pill">Đăng nhập tài khoản</a>
                                <a href="/" class="btn btn-outline-secondary px-4 rounded-pill">Về trang chủ</a>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Đang xác thực thông tin...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="container py-5 text-center">
                    <h2 class="display-4 fw-bold text-purple">404 - Không tìm thấy trang</h2>
                    <p class="text-muted">Hành trình bạn tìm kiếm không tồn tại hoặc đã được thay đổi.</p>
                    <a href="/" class="btn btn-primary rounded-pill px-4 mt-2">Trở về Trang chủ Cố Đô Huế</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
